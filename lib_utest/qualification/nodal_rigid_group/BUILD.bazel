load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_test")

cc_test(
    name = "nodal_rigid_group_check",
    srcs = ["GroupModelTest.cpp", "GroupMathTest.cpp", "GroupTestSupport.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/constraints:nodal_rigid_group", "@googletest//:gtest_main"],
)

cc_test(
    name = "nodal_rigid_step_check",
    srcs = ["GroupStepMathTest.cpp", "GroupStepTestSupport.h", "GroupTestSupport.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/constraints:nodal_rigid_group_step_math", "@googletest//:gtest_main"],
)

cuda_test(
    name = "nodal_prepared_snapshot_check",
    size = "small",
    srcs = ["PreparedSnapshotTest.cu", "PreparedSnapshotRejectionTest.cu", "PreparedSnapshotCapacityTest.cu",
            "PreparedSnapshotFaultTest.cu", "PreparedSnapshotCudaProbe.cpp", "PreparedSnapshotCudaProbe.h",
            "PreparedSnapshotFixture.h", "GroupOwnerFixture.h", "GroupStepTestSupport.h", "GroupTestSupport.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    linkopts = ["-Wl,--wrap=cudaMemcpyAsync"],
    tags = ["exclusive", "gpu"],
    deps = ["//lib_src/solvers:explicit_nodal_state", "//lib_utest:nodal_temporal_fixture", "@googletest//:gtest_main"],
)

cuda_test(
