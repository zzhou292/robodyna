! SPDX-License-Identifier: AGPL-3.0-or-later
      SUBROUTINE RD_NODAL_LENGTH(POINTS,FLAGS,TOLERANCE,RESULT,
     . DIAGNOSTICS) BIND(C)
      USE ISO_C_BINDING
      USE CONTRIBUTION_CONSTANTS
      USE CONTRIBUTION_MESSAGES
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN)::POINTS(3,2),TOLERANCE
      INTEGER(C_INT),INTENT(IN)::FLAGS(2)
      REAL(C_DOUBLE),INTENT(OUT)::RESULT
      INTEGER(C_INT),INTENT(OUT)::DIAGNOSTICS
      INTEGER ILENG,IGTYP,I,I1,I2,I3,MTN,IPID,ID,J,NIXR,
     . IXR(8,1)
      REAL(C_DOUBLE) X(3,2),XL(1),LMIN,NOISE
      CHARACTER(32) TITR
      IGTYP=FLAGS(1)
      IF(IGTYP/=13.AND.IGTYP/=25)ERROR STOP 'Unselected length'
      ILENG=FLAGS(2)
      I=1
      J=1
      I1=1
      I2=2
      I3=1
      MTN=0
      LMIN=0
      NIXR=8
      IXR=1
      ID=1
      X=POINTS
      XL=0
      NOISE=TOLERANCE
      TITR='qualified arithmetic substage'
      LENGTH_DIAGNOSTICS=0
@LENGTH@
      RESULT=XL(1)
      DIAGNOSTICS=LENGTH_DIAGNOSTICS
      END
