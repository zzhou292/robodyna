! SPDX-License-Identifier: AGPL-3.0-or-later
      SUBROUTINE RD_NODAL_SPRING(VALUES,FLAGS,SEED,RESULT)
     . BIND(C)
      USE ISO_C_BINDING
      USE CONTRIBUTION_CONSTANTS
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN)::VALUES(7),SEED
      INTEGER(C_INT),INTENT(IN)::FLAGS(2)
      REAL(C_DOUBLE),INTENT(OUT)::RESULT
      INTEGER I7STIFS,IGTYP,I,J,I0,I1,I2,I3,LFT,LLT,NFT,
     . K11,IMAT,IADBUF,MTN,IXR(8,1),IPM(7,1)
      REAL(C_DOUBLE) GEO(200,1),XL(1),STR(1),UPARAM(100),
     . STI,KX,KXY,KXZ
      IGTYP=FLAGS(1)
      IF(IGTYP/=13.AND.IGTYP/=25)ERROR STOP 'Unselected RINIT3'
      I7STIFS=FLAGS(2)
      LFT=1
      LLT=1
      NFT=0
      IXR=1
      IPM=0
      GEO=0
      UPARAM=0
      XL(1)=VALUES(7)
      STR=SEED
      GEO(3,1)=VALUES(1)
      GEO(41,1)=VALUES(2)
      GEO(10,1)=VALUES(3)
      GEO(45,1)=VALUES(4)
      GEO(15,1)=VALUES(5)
      GEO(49,1)=VALUES(6)
@SPRING@
      RESULT=STR(1)
      END
