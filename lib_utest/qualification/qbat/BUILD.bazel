load("@rules_cc//cc:defs.bzl", "cc_test", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_test")
cc_test(
    name = "qbat_geometry_check",
    size = "small",
    srcs = ["Fixture.h", "MathTest.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/elements/qbat:geometry", "@googletest//:gtest_main"],
)
cuda_test(
    name = "qbat_geometry_cuda_check",
    size = "small",
    srcs = ["Fixture.h", "MathCudaTest.cu"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    tags = ["exclusive", "gpu"],
    deps = ["//lib_src/elements/qbat:geometry", "@googletest//:gtest_main"],
)

cc_library(
    name = "fixture",
    hdrs = ["Fixture.h"],
    visibility = ["//lib_utest/qualification/qbat_force:__pkg__"],
    deps = ["//lib_src/elements/qbat:geometry"],
)

# Authenticated original midlayer geometry, shared only by source-qualified tests.
cc_library(
    name = "source_fixture",
    testonly = True,
    hdrs = ["source_fixture/YarisQbatSourceFixture.h"],
    data = ["source_fixture/source-manifest.json"],
    visibility = ["//lib_utest/qualification/t3_one_point:__pkg__",
                  "//lib_utest/qualification/qbat_binding:__pkg__"],
)
