      SUBROUTINE RD_SEARCH_GAP(N,GAP_M,GAPMSAV,RESULT) BIND(C)
      USE ISO_C_BINDING
      USE SEARCH_CONSTANTS
      IMPLICIT NONE
      INTEGER(C_INT), INTENT(IN) :: N
      REAL(C_DOUBLE), INTENT(IN) :: GAP_M(N),GAPMSAV(N)
      REAL(C_DOUBLE), INTENT(OUT) :: RESULT
      INTEGER I,NRTMF,NRTML
      REAL(C_DOUBLE) MAXDGAP_L
      NRTMF=1
      NRTML=N
      MAXDGAP_L=-EP30
@BODY@
      RESULT=MAXDGAP_L
      END
