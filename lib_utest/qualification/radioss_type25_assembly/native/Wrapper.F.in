C Qualification-only wrapper. Native loops are inserted mechanically unchanged.
      SUBROUTINE RD_ASSEMBLY(NODES,JLT,IX1,IX2,IX3,IX4,NSVG,
     . H1,H2,H3,H4,STIF,FXI,FYI,FZI,PENE,A,STIFN) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      INTEGER(C_INT),VALUE :: NODES,JLT
      INTEGER(C_INT) :: IX1(JLT),IX2(JLT),IX3(JLT),IX4(JLT),NSVG(JLT)
      REAL(C_DOUBLE) :: H1(JLT),H2(JLT),H3(JLT),H4(JLT),STIF(JLT)
      REAL(C_DOUBLE) :: FXI(JLT),FYI(JLT),FZI(JLT),PENE(JLT)
      REAL(C_DOUBLE) :: A(3,NODES),STIFN(NODES),HH(JLT)
      REAL(C_DOUBLE) :: FX1(JLT),FY1(JLT),FZ1(JLT)
      REAL(C_DOUBLE) :: FX2(JLT),FY2(JLT),FZ2(JLT)
      REAL(C_DOUBLE) :: FX3(JLT),FY3(JLT),FZ3(JLT)
      REAL(C_DOUBLE) :: FX4(JLT),FY4(JLT),FZ4(JLT)
      REAL(C_DOUBLE),PARAMETER :: ZERO=0.0_C_DOUBLE
      INTEGER :: I,J1,IG,NIN,ISHIFT
      TYPE REMOTE_BUFFER
        REAL(C_DOUBLE),ALLOCATABLE :: P(:,:)
      END TYPE
      TYPE REMOTE_STIFFNESS
        REAL(C_DOUBLE),ALLOCATABLE :: P(:)
      END TYPE
      TYPE(REMOTE_BUFFER) :: AFI(1)
      TYPE(REMOTE_STIFFNESS) :: STNFI(1)
C No remote arrays allocated: negative NSVG is outside this local oracle ABI.
      NIN=1
      ISHIFT=0
@ENDPOINT@
@MAIN@
@SECONDARY@
      END SUBROUTINE
