    ],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false",
             "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    tags = ["exclusive", "gpu"],
    deps = [
        ":cuda_fixture",
        "//lib_src/elements:shell_batch_publication",
        "//lib_src/elements/type25:type25_batch",
