load("@rules_cc//cc:defs.bzl", "cc_test")
genrule(
    name = "observed_scene",
    srcs = ["prepare.py"] + glob(["evidence/*"]),
    outs = ["ObservedScene.h"],
    cmd = "python3 -B $(location prepare.py) --output $@",
)
cc_test(
    name = "host",
    size = "small",
    srcs = ["HostTest.cpp", ":observed_scene"],
    includes = ["."],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/collision:radioss_type25_shell_source", "@googletest//:gtest_main"],
)
