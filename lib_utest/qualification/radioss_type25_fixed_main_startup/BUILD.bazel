load("@rules_cc//cc:defs.bzl", "cc_test")
cc_test(
    name = "consumer", size = "small", srcs = ["Consumer.cpp"],
    copts = ["-std=c++17", "-O0", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/collision:radioss_type25_fixed_main_startup"],
)
# Complete numerical native-source parity is owned by the CMake Fortran gate.
cc_test(
    name = "source", size = "small", srcs = ["SourceProofTest.cpp"],
    copts = ["-std=c++17"], deps = ["@googletest//:gtest_main"],
    data = glob(["native/*.py", "native/*.json", "native/*.F90", "native/*.F.in", "native/original/*"]) +
        ["//lib_utest/qualification/radioss_type25_selection:source_constants_helper"],
)
