! SPDX-License-Identifier: AGPL-3.0-or-later
! One original native local row. Contact lookup/ownership is not synthesized.
      SUBROUTINE RD_TYPE25_PHASE(VALUES,MARKERS,STIFFNESS,PROCESSOR,
     .                          MODE,OUT_VALUES,OUT_MARKERS,KEPT) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: VALUES(15),STIFFNESS(2)
      INTEGER(C_INT),INTENT(IN) :: MARKERS(4),PROCESSOR,MODE
      REAL(C_DOUBLE),INTENT(OUT) :: OUT_VALUES(15)
      INTEGER(C_INT),INTENT(OUT) :: OUT_MARKERS(4),KEPT
@CONSTANTS@
      TYPE :: ROW_STORAGE
        INTEGER IRTLM(4)
        REAL(C_DOUBLE) SECND_FR(6),PENE_OLD(5),STIF_OLD(2),TIME_S(2)
        REAL(C_DOUBLE) STFNS(1),STFM(32)
      END TYPE
      TYPE(ROW_STORAGE) INTBUF_TAB
      INTEGER N,L,NSN,ITASK,ISPMD,NSNFT,NSNLT
      INTEGER LOCAL_I_STOK(1),LOCAL_CAND_OPT_N(1),LOCAL_CAND_OPT_E(1)
      NSN=1
      ITASK=0
      ISPMD=PROCESSOR-1
      NSNFT=1
      NSNLT=1
      LOCAL_I_STOK=0
      LOCAL_CAND_OPT_N=0
      LOCAL_CAND_OPT_E=0
      INTBUF_TAB%IRTLM=MARKERS
      INTBUF_TAB%STFNS=STIFFNESS(1)
      INTBUF_TAB%STFM=STIFFNESS(2)
      INTBUF_TAB%PENE_OLD=(/VALUES(3),VALUES(1),VALUES(5),
     .                    VALUES(12),VALUES(13)/)
      INTBUF_TAB%STIF_OLD=(/VALUES(4),VALUES(2)/)
      INTBUF_TAB%SECND_FR(1:3)=VALUES(9:11)
      INTBUF_TAB%SECND_FR(4:6)=VALUES(6:8)
      INTBUF_TAB%TIME_S=VALUES(14:15)
      IF(MODE==0) THEN
@BEGIN@
      ELSE
@END@
      ENDIF
      OUT_MARKERS=INTBUF_TAB%IRTLM
      OUT_VALUES(1)=INTBUF_TAB%PENE_OLD(2)
      OUT_VALUES(2)=INTBUF_TAB%STIF_OLD(2)
      OUT_VALUES(3)=INTBUF_TAB%PENE_OLD(1)
      OUT_VALUES(4)=INTBUF_TAB%STIF_OLD(1)
      OUT_VALUES(5)=INTBUF_TAB%PENE_OLD(3)
      OUT_VALUES(6:8)=INTBUF_TAB%SECND_FR(4:6)
      OUT_VALUES(9:11)=INTBUF_TAB%SECND_FR(1:3)
      OUT_VALUES(12:13)=INTBUF_TAB%PENE_OLD(4:5)
      OUT_VALUES(14:15)=INTBUF_TAB%TIME_S
      KEPT=LOCAL_I_STOK(1)
      END SUBROUTINE
