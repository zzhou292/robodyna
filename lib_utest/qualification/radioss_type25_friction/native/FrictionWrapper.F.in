! SPDX-License-Identifier: AGPL-3.0-or-later
! Native selected blocks only; normal force comes from the qualified P1 oracle.
      SUBROUTINE RD_TYPE25_FRICTION(SCALAR,GEOMETRY,COEFFICIENT,
     .                            HISTORY,RESULT,SLOT_KIND) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: SCALAR(7),GEOMETRY(3,6)
      REAL(C_DOUBLE),INTENT(IN) :: COEFFICIENT(6),HISTORY(6)
      REAL(C_DOUBLE),INTENT(OUT) :: RESULT(20)
      INTEGER(C_INT),INTENT(IN) :: SLOT_KIND
@CONSTANTS@
      TYPE :: FOREIGN_FORCE
        REAL(C_DOUBLE) P(6,1)
      END TYPE
      TYPE(FOREIGN_FORCE) SECND_FRFI(1)
      INTEGER JLT,I,IE,JG,N,NIN,MFROT,INCONV,INTTH
      INTEGER CE_LOC(1),IRECT(4,1),NSVG(1),CAND_N_N(1)
      REAL(C_DOUBLE) PENE(1),STIF0(1),FNI(1),N1(1),N2(1),N3(1)
      REAL(C_DOUBLE) VX(1),VY(1),VZ(1),X(3,4),XMU(1),FRICC(1)
      REAL(C_DOUBLE) FRIC_COEFS(1,10),SECND_FR(6,1)
      REAL(C_DOUBLE) FXI(1),FYI(1),FZI(1),FXT(1),FYT(1),FZT(1)
      REAL(C_DOUBLE) EFRICT(1),EFRIC_L(1),ECONVT,QFRICT
      REAL(C_DOUBLE) DT1,DT12,ALPHA,TINY,AA,V2,VV,AREA,P
      REAL(C_DOUBLE) AX1,AY1,AZ1,AX2,AY2,AZ2,AX,AY,AZ
      REAL(C_DOUBLE) FX,FY,FZ,FTN,FT,FN,BETA
      JLT=1
      NIN=1
      CE_LOC=1
      IRECT(:,1)=(/1,2,3,4/)
      NSVG=SLOT_KIND
      CAND_N_N=1
      MFROT=2
      INCONV=1
      INTTH=0
      TINY=EM30
      PENE(1)=SCALAR(1)
      STIF0(1)=SCALAR(2)
      DT1=SCALAR(3)
      DT12=SCALAR(4)
      FNI(1)=SCALAR(5)
      ALPHA=SCALAR(6)
      FRICC(1)=SCALAR(7)
      N1(1)=GEOMETRY(1,1)
      N2(1)=GEOMETRY(2,1)
      N3(1)=GEOMETRY(3,1)
      VX(1)=GEOMETRY(1,2)
      VY(1)=GEOMETRY(2,2)
      VZ(1)=GEOMETRY(3,2)
      X=GEOMETRY(:,3:6)
      FRIC_COEFS=ZERO
      FRIC_COEFS(1,1:6)=COEFFICIENT
      SECND_FR(1:3,1)=HISTORY(4:6)
      SECND_FR(4:6,1)=HISTORY(1:3)
      SECND_FRFI(1)%P=SECND_FR
      FX=ZERO
      FY=ZERO
      FZ=ZERO
      FXI=ZERO
      FYI=ZERO
      FZI=ZERO
      IF(PENE(1)/=ZERO) THEN
        FXI(1)=N1(1)*FNI(1)
        FYI(1)=N2(1)*FNI(1)
        FZI(1)=N3(1)*FNI(1)
      ENDIF
      FXT=ZERO
      FYT=ZERO
      FZT=ZERO
      XMU=ZERO
      AREA=ZERO
      P=ZERO
      BETA=ZERO
      EFRICT=ZERO
      EFRIC_L=ZERO
      ECONVT=ZERO
      QFRICT=ZERO
@COEFFICIENT@
@TANGENT@
      RESULT(1:3)=(/FX,FY,FZ/)
      RESULT(4:6)=(/FXT(1),FYT(1),FZT(1)/)
      RESULT(7:9)=(/FXI(1),FYI(1),FZI(1)/)
      RESULT(10)=XMU(1)
      RESULT(11)=BETA
      RESULT(12)=AREA
      RESULT(13)=P
      RESULT(14)=ECONVT
      IF(SLOT_KIND>0) THEN
        RESULT(15:17)=SECND_FR(4:6,1)
        RESULT(18:20)=SECND_FR(1:3,1)
      ELSE
        RESULT(15:17)=SECND_FRFI(1)%P(4:6,1)
        RESULT(18:20)=SECND_FRFI(1)%P(1:3,1)
      ENDIF
      END SUBROUTINE
