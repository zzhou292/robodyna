load("@rules_cc//cc:defs.bzl", "cc_test")
cc_test(
    name = "consumer", size = "small", srcs = ["ConsumerTest.cpp", "PrecisionProbe.h"],
    # Bazel cannot propagate compile options through cc_library as CMake usage requirements do.
    copts = ["-std=c++17", "-O0", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/collision:radioss_type25_friction", "@googletest//:gtest_main"],
)
cc_test(
    name = "source", size = "small", srcs = ["SourceProofTest.cpp"],
    data = ["native/prepare.py", "native/actual_fixture.py", "native/FrictionWrapper.F.in", "native/PhaseWrapper.F.in", "native/source-manifest.json",
            "//lib_utest/qualification/radioss_type25_normal:native_source_files"] + glob(["native/original/*"]),
    copts = ["-std=c++17"], deps = ["@googletest//:gtest_main"],
)

filegroup(
    name = "geometry_source_files",
    srcs = ["native/original/i25dst3_3.F", "native/original/i25mainf.F"],
    visibility = ["//lib_utest/qualification/radioss_type25_local_geometry:__pkg__"],
)

filegroup(
    name = "lifecycle_source_files",
    srcs = glob(["native/**"]),
    visibility = ["//lib_utest/qualification/radioss_type25_lifecycle:__pkg__"],
)
