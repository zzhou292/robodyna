      SUBROUTINE RD_SEED_JOINT(KNN,RESULT,OBSERVED_KN) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      REAL(C_DOUBLE),INTENT(IN)::KNN
      REAL(C_DOUBLE),INTENT(OUT)::RESULT,OBSERVED_KN
      INTEGER I7STIFS,IGTYP,I,J,I0,I1,I2,I3,LFT,LLT,NFT,
     . K11,IMAT,IADBUF,MTN,IXR(8,1),IPM(7,1),IERROR
      REAL(C_DOUBLE) GEO(200,1),XL(1),STR(1),UPARAM(100),
     . STI,KX,KXY,KXZ,PARGEO(6),STIF,U_GEO10
      IGTYP=45
      I7STIFS=1
      LFT=1
      LLT=1
      NFT=0
      IXR=1
      IPM=0
      GEO=ZERO
      UPARAM=ZERO
      XL=ONE
      STR=73
      PARGEO=73
@PROPERTY45@
@STORE_KN@
@GENERIC_STIFFNESS@
@GEO_STIFFNESS@
@SPRING@
      RESULT=STR(1)
      OBSERVED_KN=U_GEO10
      CONTAINS
      INTEGER FUNCTION SET_U_GEO(SLOT,VALUE)
      INTEGER,INTENT(IN)::SLOT
      REAL(C_DOUBLE),INTENT(IN)::VALUE
      IF(SLOT/=10)ERROR STOP 'Unselected joint storage channel'
      U_GEO10=VALUE
      SET_U_GEO=0
      END FUNCTION
      END
