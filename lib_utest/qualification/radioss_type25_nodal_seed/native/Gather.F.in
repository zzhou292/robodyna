! SPDX-License-Identifier: AGPL-3.0-or-later
      SUBROUTINE RD_SEED_GATHER(NUMNOD,NUMELS,NUMELC,NUMELTG,
     . NUMELT,NUMELP,NUMELR,IXS,IXC,IXTG,IXT,IXP,IXR,
     . VNS,BNS,YOUNGQ,THK,YOUNGT,THKT,STT,STP,STR,
     . VOLNOD,BVOLNOD,ETNOD,NSHNOD,STIFINT) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      INTEGER(C_INT),VALUE::NUMNOD,NUMELS,NUMELC,NUMELTG,
     . NUMELT,NUMELP,NUMELR
      INTEGER(C_INT),INTENT(IN)::IXS(11,*),IXC(7,*),IXTG(6,*),
     . IXT(5,*),IXP(6,*),IXR(6,*)
      REAL(C_DOUBLE),INTENT(IN)::VNS(8,*),BNS(8,*),YOUNGQ(*),
     . THK(*),YOUNGT(*),THKT(*),STT(*),STP(*),STR(*)
      REAL(C_DOUBLE),INTENT(OUT)::VOLNOD(NUMNOD),BVOLNOD(NUMNOD),
     . ETNOD(NUMNOD),STIFINT(NUMNOD)
      INTEGER(C_INT),INTENT(OUT)::NSHNOD(NUMNOD)
      INTEGER I,J,K,N,P,IMID,IMAT,LFT,LLT,I7STIFS,IGTYP,
     . INDEX(512),ITRI(256),WORK(70000),
     . IX1(256),IX2(256),IX3(256),IX4(256)
      REAL(C_DOUBLE) STC(256),STTG(256),PM(20,256),ET,
     . STRC(256),STRTG(256),STRP(256),STRR(256),
     . STIFINTR(NUMNOD),GEO(12,256)
      IF(NUMNOD<1.OR.NUMNOD>1024)ERROR STOP 'Seed node cap'
      IF(MAX(NUMELS,NUMELC,NUMELTG,NUMELT,NUMELP,NUMELR)>256)
     . ERROR STOP 'Seed parent cap'
      I7STIFS=1
      STRC=ZERO
      STRTG=ZERO
      STRP=ZERO
      STRR=ZERO
      GEO=ZERO
@INITIALIZE@
      DO P=1,NUMELR
        GEO(12,P)=REAL(IXR(5,P),C_DOUBLE)
      ENDDO
! Original ordinary CINMAS/C3INMAS blocks, one actual material group at a time.
      DO P=1,NUMELC
        IMID=P
        PM(20,P)=YOUNGQ(P)
        IX1(P)=IXC(2,P)
        IX2(P)=IXC(3,P)
        IX3(P)=IXC(4,P)
        IX4(P)=IXC(5,P)
        LFT=P
        LLT=P
@QUAD_INITIALIZE@
      ENDDO
      DO P=1,NUMELTG
        IMAT=P
        PM(20,P)=YOUNGT(P)
        IX1(P)=IXTG(2,P)
        IX2(P)=IXTG(3,P)
        IX3(P)=IXTG(4,P)
        LFT=P
        LLT=P
! THK is the original dummy name in C3INMAS; this private wrapper binds THKT.
@TRIANGLE_INITIALIZE@
      ENDDO
@SOLID_SORT@
@SOLID@
@QUAD_SORT@
@QUAD@
@TRUSS_SORT@
@TRUSS@
@BEAM_SORT@
@BEAM@
@SPRING_SORT@
@SPRING@
@TRIANGLE_SORT@
@TRIANGLE@
      END
