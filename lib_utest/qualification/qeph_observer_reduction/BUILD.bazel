load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_test")
cc_library(
    name = "fixture",
    hdrs = ["Fixture.h"],
    deps = ["//lib_utest/qualification/qeph_candidate_diagnostics:fixture", "//lib_src/elements/qeph:batch_values", "@googletest//:gtest"],
)
cc_library(
    name = "truth",
    srcs = ["Truth.cpp"],
    hdrs = ["Truth.h"],
    deps = [":fixture"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
)
cc_test(
    name = "host", size = "small",
    srcs = ["HostTest.cpp"],
    deps = [":truth", "@googletest//:gtest_main"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
)
cuda_test(
    name = "cuda", size = "small",
    srcs = ["CudaTest.cu"],
    deps = [":fixture", ":truth", "//lib_src/elements/qeph:batch", "@googletest//:gtest_main"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    tags = ["exclusive", "gpu"],
)
