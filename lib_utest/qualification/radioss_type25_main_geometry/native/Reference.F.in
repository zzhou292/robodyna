! Complete selected arithmetic extracted from original native routines.
      SUBROUTINE RD_MAIN_GEOMETRY(P,LAYOUT,R,SLOTS,REVERSED) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: P(3,12)
      INTEGER(C_INT),INTENT(IN) :: LAYOUT
      REAL(C_DOUBLE),INTENT(OUT) :: R(6)
      INTEGER(C_INT),INTENT(OUT) :: SLOTS(4),REVERSED
      INTEGER IRECT(4,1),IXS(13,1),K,NINV
      REAL(C_DOUBLE) VOL,N1,N2,N3,AREA,DDS
      IRECT(:,1)=(/1,2,3,4/)
      IF(LAYOUT==3)IRECT(4,1)=3
      IXS=0
      DO K=1,8
        IXS(K+1,1)=K+4
      ENDDO
      NINV=0
      CALL RD_MAIN_ORIENT(P,IRECT,IXS,N1,N2,N3,AREA,DDS,NINV)
      CALL RD_MAIN_VOLUME(P(1,5:12),P(2,5:12),P(3,5:12),VOL)
      R=(/N1,N2,N3,AREA,VOL,DDS/)
      SLOTS=IRECT(:,1)-1
      REVERSED=NINV
      END SUBROUTINE

      SUBROUTINE RD_MAIN_ORIENT(X,IRECT,IXS,N1,N2,N3,AREA,DDS,NINV)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      REAL(C_DOUBLE),INTENT(IN) :: X(3,12)
      INTEGER,INTENT(INOUT) :: IRECT(4,1),NINV
      INTEGER,INTENT(IN) :: IXS(13,1)
      REAL(C_DOUBLE),INTENT(OUT) :: N1,N2,N3,AREA,DDS
      INTEGER I,NEL,IR,IC,JJ,NN,K,KK,IY(4)
      REAL(C_DOUBLE) XX1(4),XX2(4),XX3(4),XS1,YS1,ZS1,XC,YC,ZC
! Membership/caller contract already resolved: one exterior EightSlot, IR=0.
      I=1
      NEL=1
      IR=0
      IC=1
@ORIENTATION@
      RETURN
      END SUBROUTINE

      SUBROUTINE RD_MAIN_NORMA1D(N1,N2,N3,AREA,XX1,XX2,XX3)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      REAL(C_DOUBLE),INTENT(IN) :: XX1(4),XX2(4),XX3(4)
      REAL(C_DOUBLE),INTENT(OUT) :: N1,N2,N3,AREA
      REAL(C_DOUBLE) XX13,YY13,ZZ13,XX24,YY24,ZZ24
@NORMAL@
      RETURN
      END SUBROUTINE

      SUBROUTINE RD_MAIN_VOLUME(XC,YC,ZC,VOL)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      REAL(C_DOUBLE),INTENT(IN) :: XC(8),YC(8),ZC(8)
      REAL(C_DOUBLE),INTENT(OUT) :: VOL
      REAL(C_DOUBLE) X17,X28,X35,X46,Y17,Y28,Y35,Y46,Z17,Z28,Z35,Z46
      REAL(C_DOUBLE) A17,A28,B17,B28,C17,C28
      REAL(C_DOUBLE) JAC1,JAC2,JAC3,JAC4,JAC5,JAC6,JAC7,JAC8,JAC9
      REAL(C_DOUBLE) JAC_59_68,JAC_67_49,JAC_48_57
@VOLUME@
      RETURN
      END SUBROUTINE

      FUNCTION RD_MAIN_EM20() RESULT(VALUE) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      REAL(C_DOUBLE) VALUE
      VALUE=EM20
      END FUNCTION
