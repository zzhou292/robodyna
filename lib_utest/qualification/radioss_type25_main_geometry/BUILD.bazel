load("@rules_cc//cc:defs.bzl", "cc_test")
cc_test(
    name = "consumer",
    size = "small",
    srcs = ["Consumer.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/collision:radioss_type25_main_geometry"],
)
cc_test(
    name = "source",
    size = "small",
    srcs = ["SourceProofTest.cpp"],
    copts = ["-std=c++17"],
    data = ["native/prepare.py", "native/source-manifest.json", "native/Reference.F.in"] +
        glob(["native/original/*"]) +
        ["//lib_utest/qualification/radioss_type25_normal:native_source_files"],
    deps = ["@googletest//:gtest_main"],
)
