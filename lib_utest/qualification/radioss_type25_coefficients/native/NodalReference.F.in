      SUBROUTINE RD_TYPE25_NODAL_COEFFICIENT(VALUES,COUNT,RESULT) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: VALUES(4)
      INTEGER(C_INT),INTENT(IN) :: COUNT
      REAL(C_DOUBLE),INTENT(OUT) :: RESULT(2)
@CONSTANTS@
      INTEGER N,NUMNOD,NSHNOD(1)
      REAL(C_DOUBLE) VOLNOD(1),BVOLNOD(1),ETNOD(1),STIFINT(1)
      NUMNOD=1
      VOLNOD=VALUES(1)
      BVOLNOD=VALUES(2)
      ETNOD=VALUES(3)
      NSHNOD=COUNT
      STIFINT=VALUES(4)
@NODAL@
      RESULT(1)=BVOLNOD(1)
      RESULT(2)=STIFINT(1)
      END SUBROUTINE

      SUBROUTINE RD_TYPE25_SECONDARY_COEFFICIENT(VALUES,RESULT) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: VALUES(3)
      REAL(C_DOUBLE),INTENT(OUT) :: RESULT
@CONSTANTS@
      TYPE :: LOCAL_ROW
        INTEGER NSV(1)
        REAL(C_DOUBLE) STFNS(1)
      END TYPE
      TYPE(LOCAL_ROW) INTBUF_TAB
      INTEGER IPARI(5),NSN,I,J
      REAL(C_DOUBLE) STIFINT(1),SFAC,S
      IPARI=0
      IPARI(5)=1
      INTBUF_TAB%NSV=1
      INTBUF_TAB%STFNS=VALUES(1)
      STIFINT=VALUES(2)
      SFAC=VALUES(3)
@SECONDARY@
      RESULT=INTBUF_TAB%STFNS(1)
      END SUBROUTINE
