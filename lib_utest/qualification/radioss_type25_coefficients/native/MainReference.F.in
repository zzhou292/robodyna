      SUBROUTINE RD_TYPE25_SHELL_COEFFICIENT(VALUES,FLAGS,RESULT) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: VALUES(4)
      INTEGER(C_INT),INTENT(IN) :: FLAGS(3)
      REAL(C_DOUBLE),INTENT(OUT) :: RESULT
@CONSTANTS@
      INTEGER I,MT,MG,IGTYP,IINTTHICK,NELC,NUMELC,NELTG
      REAL(C_DOUBLE) SLSFAC,THK(2),GEO(1,1),PM(20,1),STC,STF(1)
      I=1
      MT=1
      MG=1
      NELC=1
      NUMELC=1
      NELTG=1
      IGTYP=FLAGS(1)
      IINTTHICK=FLAGS(2)
      SLSFAC=VALUES(1)
      THK=VALUES(2)
      GEO(1,1)=VALUES(3)
      PM=ZERO
      PM(20,1)=VALUES(4)
      STF=ZERO
      IF(FLAGS(3)==3)THEN
@TRIANGLE@
      ELSE
@QUAD@
      ENDIF
      RESULT=STF(1)
      END SUBROUTINE

      SUBROUTINE RD_TYPE25_SOLID_COEFFICIENT(VALUES,FLAGS,RESULT) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: VALUES(6)
      INTEGER(C_INT),INTENT(IN) :: FLAGS(2)
      REAL(C_DOUBLE),INTENT(OUT) :: RESULT(2)
@CONSTANTS@
      INTEGER I,NELS,MT,ICONTR,NUMELS8,NUMELS10,NUMELS20,NUMELS16
      REAL(C_DOUBLE) SLSFAC,FILLSOL(4),AREA,VOL,PM(107,1),BULK,STF(1),GAP_N(1,1)
      I=1
      MT=1
      NUMELS8=1
      NUMELS10=1
      NUMELS20=1
      NUMELS16=1
      NELS=FLAGS(1)
      ICONTR=FLAGS(2)
      SLSFAC=VALUES(1)
      FILLSOL=VALUES(2)
      AREA=VALUES(3)
      VOL=VALUES(4)
      PM=ZERO
      PM(32,1)=VALUES(5)
      PM(107,1)=VALUES(6)
@SOLID@
      RESULT(1)=STF(1)
      RESULT(2)=GAP_N(1,1)
      END SUBROUTINE
