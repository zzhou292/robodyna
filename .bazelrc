common --enable_bzlmod
build --lockfile_mode=error
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Import only declared Python package roots and the main repository. Data-only
# external repositories (including the legacy watchdog) must not shadow tools/.
# rules_python 1.7 reads the native option when its fragments exist, otherwise
# its Starlark replacement. Keep both definitions consistent on Bazel 9.
build --noexperimental_python_import_all_repositories
build --@rules_python//python/config_settings:experimental_python_import_all_repositories=false

# Scheduling limits supplement the workstation guard; they are not an RSS cap.
build --jobs=4
build --local_resources=cpu=4
build --local_resources=memory=16384
test --local_test_jobs=1

# Keep numerical flags target-local. Inherited explicit and implicit backends
# have different qualified policies; neither fast math nor its inverse is global.
build:host --compilation_mode=opt

# This profile changes retained contact class layouts. Apply coherently to the
# whole configured build graph; never enable it in a single demo translation unit.
build:multiphysics --//build_defs/features:fea_multiphysics=true

# Coherent OpenMP host profile, including nvcc host compilation. No device math
# flag or Thrust backend is changed globally.
build:multicore --//build_defs/features:multicore=true
build:multicore --cxxopt=-fopenmp
build:multicore --linkopt=-fopenmp
build:multicore --@rules_cuda//cuda:host_copts=-fopenmp
build:cuda --compilation_mode=opt
build --flag_alias=cuda_archs=@rules_cuda//cuda:archs
build --@rules_cuda//cuda:archs=compute_75:sm_75;compute_86:sm_86,compute_86
build:sm75 --@rules_cuda//cuda:archs=compute_75:sm_75,compute_75
build:sm75 --define=robodyna_cuda_arch=75
build:sm86 --@rules_cuda//cuda:archs=compute_86:sm_86,compute_86
build:sm86 --define=robodyna_cuda_arch=86
build:sm120 --@rules_cuda//cuda:archs=compute_120:sm_120,compute_120
build:sm120 --define=robodyna_cuda_arch=120

# Optional foreign builds use the explicitly supplied local CUDA installation.
# The guarded build must verify these identify the same toolkit as rules_cuda.
build --action_env=CUDACXX
build --action_env=CUDAToolkit_ROOT
build --action_env=CUDA_PATH

# These flags configure all declarations and implementation owners together.
build:fsi-sph --//build_defs/features:fsi_sph=true
build:opencrg --//build_defs/features:opencrg=true
build:sensor-optix --//build_defs/features:sensor_backend=optix
build:sensor-optix-sph --config=sensor-optix
build:sensor-optix-sph --config=fsi-sph

# Parser and virtual visualization interfaces share one generated profile.
build:yaml --//build_defs/features:yaml=true
build:yaml --//build_defs/features:vsg=true
build:vsg --//build_defs/features:vsg=true
build:fsi_tdpf --//build_defs/features:fsi_tdpf=true

build:ros-sensor --//build_defs/features:ros_sensor=true
build:ros-urdf --//build_defs/features:ros_urdf=true
