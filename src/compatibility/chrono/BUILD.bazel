        "src/chrono_sensor/metal/ChMetalSceneBuilder.h",
        "src/chrono_swig/interface/core/ChBody.i",
        "src/chrono_swig/interface/core/ChModuleCore.i",
        "src/chrono_swig/CMakeLists.txt",
        "src/chrono_swig/chrono_python/CMakeLists.txt",
        "src/chrono_swig/chrono_csharp/CMakeLists.txt",
