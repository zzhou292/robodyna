    "src/demos/mbs/demo_MBS_spring.cpp",
    "src/demos/mbs/demo_MBS_collisionNSC.cpp",
    "src/demos/vehicle/terrain/demo_VEH_SCMTerrain_RigidTire.cpp",
    "data/models/tractor_wheel/tractor_wheel.obj",
])

filegroup(
    name = "scm_demo_assets",
    srcs = [":vsg_assets", "data/models/tractor_wheel/tractor_wheel.obj"],
)

filegroup(
    name = "rigid_demo_assets",
    srcs = [":vsg_assets"] + glob([
        "data/textures/bluewhite.png", "data/textures/cubetexture_bluewhite.png",
        "data/textures/pinkwhite.png", "data/textures/concrete.jpg", "data/textures/blue.png",
    ]),
)

# Export unchanged source bytes to their real neutral native compile owners.
exports_files(
    [path for paths in NEUTRAL_SOURCES.values() for path in paths if path not in SOURCE_RELOCATIONS] +
    [path for paths in NEUTRAL_HEADERS.values() for path in paths] +
    ["src/tests/unit_tests/physics/utest_CH_composite_inertia.cpp"],
)

# Include-root compatibility only: no headers and no implementation are hidden
# here. Neutral owners enumerate their own exact header closure.
cc_library(name = "neutral_include_root", includes = ["src"])

# Generic visual owners enumerate their headers and sources separately from the
# aggregate. The existing source import remains the historical identity.
exports_files(
    [path for paths in VISUAL_SOURCES.values() for path in paths] +
    [path for paths in VISUAL_HEADERS.values() for path in paths] + VISUAL_EXTRA_HEADERS,
)

filegroup(
    name = "visual_source_inputs",
    srcs = [path for paths in VISUAL_SOURCES.values() for path in paths] +
           [path for paths in VISUAL_HEADERS.values() for path in paths] +
           VISUAL_EXTRA_HEADERS + VISUAL_ADAPTER_SOURCES,
)

filegroup(
    name = "neutral_source_inputs",
    srcs = [current_source_label(path) for paths in NEUTRAL_SOURCES.values() for path in paths] +
           [path for paths in NEUTRAL_HEADERS.values() for path in paths] +
           ["//include/robodyna/mechanics:RbMassProperties.h"],
)

# All absorbed first-party source remains available during native package
# extraction. No external checkout or previously installed Chrono is referenced.
filegroup(
    name = "source_tree",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel", "**/.git/**"],
    ),
)

