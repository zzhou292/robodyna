    srcs = [
        "src/chrono/physics/ChBody.h", "src/chrono/physics/ChBodyFwd.h",
        "src/chrono/physics/ChForce.h", "src/chrono/physics/ChMarker.h",
        "src/chrono/physics/ChSystem.h", "src/chrono/utils/ChBodyGeometry.h",
        "src/chrono/collision/ChCollisionSystem.h",
