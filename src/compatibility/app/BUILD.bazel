load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Source-only export boundary. Native libraries under build_defs/app declare
# precise translation units and headers; this does not compile a source glob.
_REQUIRED_NATIVE_SOURCES = glob(
    [
        "case/vehicle_native_contact/Run.h",
        "case/vehicle_native_contact/run/Prepare.cpp",
        "case/vehicle_native_contact/source/OriginalSources.h",
        "output/ArtifactIO.cpp",
    ],
    allow_empty = False,
)

exports_files(
    _REQUIRED_NATIVE_SOURCES + glob(
        ["**/*.cpp", "**/*.h", "**/*.hpp", "**/*.cuh", "**/*.cmake", "**/CMakeLists.txt"],
        exclude = ["**/tests/**", "**/frozen/**"] + _REQUIRED_NATIVE_SOURCES,
        allow_empty = True,
    ),
    visibility = ["//build_defs/app:__subpackages__", "//src/simulation/driver:__subpackages__"],
)

# Transitional rooted includes. This adds no implementation or hidden headers;
# the consuming library still declares every header through its dependencies.
cc_library(name = "include_root", includes = ["."])

filegroup(
    name = "renamed_type_source_inputs",
    srcs = [
        "chrono/AcceptedReplayScene.cpp",
        "chrono/AcceptedReplayScene.h",
        "chrono/ReplayDisplayGeometry.cpp",
        "chrono/ReplayDisplayGeometry.h",
        "chrono/ReplayVisuals.cpp",
        "chrono/ReplayVisuals.h",
        "chrono/physical_run/Scene.cpp",
        "chrono/physical_run/Scene.h",
        "chrono/physical_run/SceneInitialize.cpp",
        "chrono/physical_run/SceneState.h",
        "viewer/ReplayVsg.cpp",
        "viewer/ReplayVsg.h",
    ],
    visibility = ["//tests/chrono:__pkg__"],
)

# Focused inherited viewer-value regressions; frozen model fixtures remain private.
exports_files(
    [
        "chrono/physical_run/tests/ViewerValuesTest.cpp",
        "chrono/physical_run/tests/FixedCameraTest.cpp",
        "chrono/physical_run/tests/ClippingTest.cpp",
        "output/full_shell/tests/TestSupport.h",
    ],
    visibility = ["//build_defs/app/viewer/tests:__pkg__"],
)

py_library(
    name = "python_io",
    srcs = ["viewer/file_integrity.py", "output/gtest_evidence.py"] + glob(
        ["viewer/postprocess/*.py", "viewer/__init__.py", "output/__init__.py"],
        exclude = ["**/test_*.py"],
        allow_empty = True,
    ),
    imports = ["."],
)

py_library(
    name = "python_video",
    srcs = glob(["viewer/video/capture.py", "viewer/video/encode.py", "viewer/video/brand.py",
                 "viewer/video/publication.py", "viewer/video/publication_source.py"], allow_empty = False),
    imports = ["."],
    deps = [":python_io"],
)

py_library(
    name = "python_video_test_fixtures",
    srcs = ["viewer/video/tests/fixtures.py"],
    imports = ["."],
    visibility = ["//build_defs/app/viewer/tests:__pkg__"],
)
exports_files(
    ["viewer/video/tests/test_capture.py", "viewer/video/tests/test_encode.py", "viewer/video/tests/test_brand.py",
     "viewer/video/tests/test_publication.py"],
    visibility = ["//build_defs/app/viewer/tests:__pkg__"],
)

# Exact JSON spelling comparison reused by the migration gate; implementation
# remains unchanged in the retained output utility.
py_library(
    name = "python_exact_json",
    srcs = ["output/json_object.py"],
    imports = ["."],
    visibility = ["//tools/migration:__pkg__"],
)

# Exact imported presentation inputs for the shared inverse-source proof.
filegroup(
    name = "branding_source_inputs",
    srcs = [
    "viewer/ReplayAssets.cpp",
    "viewer/ReplayVsg.cpp",
    "viewer/physical_run/Options.cpp",
    "viewer/physical_run/Overlay.cpp",
    "viewer/physical_run/main.cpp"
],
    visibility = ["//tests/chrono:__pkg__"],
)
