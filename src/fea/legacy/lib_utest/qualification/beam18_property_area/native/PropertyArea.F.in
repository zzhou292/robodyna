! SPDX-License-Identifier: AGPL-3.0-or-later
! Original full DEFBEAM_SECT; exact reader store/report and gap expression.
      SUBROUTINE BEAM18_PROPERTY_AREA_NATIVE(RADIUS,VALUES,STATUS)
     . BIND(C,NAME="beam18_property_area_native")
      USE ISO_C_BINDING
      USE BEAM18_REF_CONSTANT_MOD
      USE BEAM18_REF_MESSAGE_MOD,ONLY:ERRORS,WARNINGS
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN)::RADIUS
      REAL(C_DOUBLE),INTENT(OUT)::VALUES(4)
      INTEGER(C_INT),INTENT(OUT)::STATUS
      REAL(C_DOUBLE)::GEO(512),L(6),AREA,AREA_I,TIYY_I,TIZZ_I,
     . TIXX_I,ARI,INI,RYI,RZI,DX
      INTEGER NIP,IP,IPA,IPY,IPZ
      CHARACTER(100) TITLE
      STATUS=1
      ERRORS=0
      WARNINGS=0
      GEO=ZERO
      L=ZERO
      L(1)=RADIUS
      TITLE='Native pre-PMASS circular property area'
      CALL BEAM18_REF_DEFBEAM_SECT(GEO,2,2,NIP,AREA,L,1,TITLE)
      IF(NIP/=4.OR.ERRORS/=0)RETURN
      IPA=400
      IPY=200
      IPZ=300
@READER_PRINT_VALUES@
@PROPERTY_STORE@
@BEAM_GAP@
      VALUES=(/AREA,GEO(1),AREA_I,DX/)
      STATUS=0
      END
