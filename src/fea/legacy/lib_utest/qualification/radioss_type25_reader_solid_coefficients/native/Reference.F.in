! Selected native EightSlot branch. Second support is addressed through IXS.
      SUBROUTINE RD_READER_COEFFICIENT(V,F,X,R) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      REAL(C_DOUBLE),INTENT(IN) :: V(9),X(3,8)
      INTEGER(C_INT),INTENT(IN) :: F(2)
      REAL(C_DOUBLE),INTENT(OUT) :: R(3)
@CONSTANTS@
      INTEGER I,MT,MT2,NELS,NELS2,ICONTR,JJ,JJJ,NSOL_INT
      INTEGER IELEM_M(2,1),IXS(9,2)
      REAL(C_DOUBLE) PM(107,2),FILLSOL(2),STF(1),GAP_N(1,1)
      REAL(C_DOUBLE) SLSFAC,AREA,VOL,VOL2,BULK,STF1,STF2
      REAL(C_DOUBLE) XC(8),YC(8),ZC(8)
      I=1
      MT=1
      NELS=1
      ICONTR=F(1)
      IELEM_M=0
      IF(F(2)/=0)IELEM_M(2,1)=2
      IXS=0
      IXS(1,2)=2
      DO JJ=1,8
        IXS(JJ+1,2)=JJ
      ENDDO
      SLSFAC=V(1)
      FILLSOL(1)=V(2)
      AREA=V(3)
      VOL=V(4)
      PM=ZERO
      PM(32,1)=V(5)
      PM(107,1)=V(6)
      FILLSOL(2)=V(7)
      PM(32,2)=V(8)
      PM(107,2)=V(9)
      NSOL_INT=0
      VOL2=ZERO
@CONTRIBUTION@
@LENGTH@
@SIGN@
      R=(/STF(1),GAP_N(1,1),VOL2/)
      END SUBROUTINE

      SUBROUTINE RD_READER_VOLUME(XC,YC,ZC,VOL)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      REAL(C_DOUBLE),INTENT(IN) :: XC(8),YC(8),ZC(8)
      REAL(C_DOUBLE),INTENT(OUT) :: VOL
      REAL(C_DOUBLE) X17,X28,X35,X46,Y17,Y28,Y35,Y46,Z17,Z28,Z35,Z46
      REAL(C_DOUBLE) A17,A28,B17,B28,C17,C28
      REAL(C_DOUBLE) JAC1,JAC2,JAC3,JAC4,JAC5,JAC6,JAC7,JAC8,JAC9
      REAL(C_DOUBLE) JAC_59_68,JAC_67_49,JAC_48_57
@VOLUME@
      RETURN
      END SUBROUTINE
