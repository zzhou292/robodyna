      SUBROUTINE rd_startup_margin(NUMNOD,NRTM,NSN,X,IRECT,
     1 MSEGTYP,NSV,STFN,GAP,BUMULT,DD0,MARGE)
      USE margin_reduction_mod
#include "implicit_f.inc"
      INTEGER NUMNOD,NRTM,NSN,IRECT(4,NRTM),MSEGTYP(NRTM),NSV(NSN)
      INTEGER NRTMT,L,N1,N2,N3,N4,N_SOL
      REAL(C_DOUBLE) X(3,NUMNOD),STFN(NSN),GAP,BUMULT,DD0,MARGE
      REAL(C_DOUBLE) DRAD,DGAPLOAD,DD,DD_ST,PENSOL,D_MOY,D_MAX
      REAL(C_DOUBLE) DX1,DY1,DZ1,DX3,DY3,DZ3,DX4,DY4,DZ4,DX6,DY6,DZ6
      REAL(C_DOUBLE) DD1,DD2,DD3,DD4,GAP_N(4,NRTM)
      NRTMT=NRTM
      DRAD=ZERO
      DGAPLOAD=ZERO
      GAP_N=ZERO
@MARGIN@
      END
      SUBROUTINE rd_startup_multiplier(NUMNOD,BUMULT) bind(C)
#include "implicit_f.inc"
      INTEGER(C_INT),INTENT(IN)::NUMNOD
      REAL(C_DOUBLE),INTENT(OUT)::BUMULT
      REAL(C_DOUBLE) BMUL0
@BASE@
@MULTIPLIER@
      END
