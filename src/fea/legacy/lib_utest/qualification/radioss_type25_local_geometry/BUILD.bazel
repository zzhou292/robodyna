load("@rules_cc//cc:defs.bzl", "cc_test", "cc_library")
# Native Fortran and CUDA arithmetic gates are owned by CMake.
cc_test(
    name = "consumer", size = "small", srcs = ["ConsumerTest.cpp", "Cases.h"],
    copts = ["-std=c++17", "-O0", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/collision:radioss_type25_local_geometry", "@googletest//:gtest_main"],
)
cc_test(
    name = "source", size = "small", srcs = ["SourceProofTest.cpp"],
    data = ["native/prepare.py", "native/RawWrapper.F.in", "native/HistoryWrapper.F.in",
            "native/source-manifest.json", "native/original/i25cor3.F",
            "//lib_utest/qualification/radioss_type25_normal:native_source_files",
            "//lib_utest/qualification/radioss_type25_friction:geometry_source_files"],
    copts = ["-std=c++17"], deps = ["@googletest//:gtest_main"],
)

cc_library(
    name = "case_values",
    hdrs = ["Cases.h"],
    deps = ["//lib_src/collision:radioss_type25_local_geometry"],
    visibility = ["//lib_utest/qualification/radioss_type25_selection:__pkg__"],
)
