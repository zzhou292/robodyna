! SPDX-License-Identifier: AGPL-3.0-or-later
! Exactly one supplied native DST3_3 logical cohort, with repeated local rows.
! Remote storage exists only so original conditional blocks compile unchanged.
      SUBROUTINE RD_TYPE25_GEOMETRY_HISTORY(COUNT,ROWS,INDICES,
     . MARKERS,INPUT_P,INPUT_K,OFFSETS,STAGED,TIME,OUT_P,OUT_OFFSETS,
     . OUT_STAGED) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      INTEGER(C_INT),INTENT(IN) :: COUNT,ROWS,INDICES(*),MARKERS(*)
      REAL(C_DOUBLE),INTENT(IN) :: INPUT_P(*),INPUT_K(*),
     . OFFSETS(*),STAGED(*),TIME
      REAL(C_DOUBLE),INTENT(OUT) :: OUT_P(*),OUT_OFFSETS(*),OUT_STAGED(*)
@CONSTANTS@
      INTEGER,PARAMETER :: CAPACITY=256
      TYPE :: FOREIGN_INTEGER
        INTEGER P(4,CAPACITY)
      END TYPE
      TYPE :: FOREIGN_REAL
        REAL(C_DOUBLE) P(5,CAPACITY)
      END TYPE
      TYPE :: LOCAL_STORAGE
        REAL(C_DOUBLE) STIF_OLD(2*CAPACITY)
      END TYPE
      TYPE(FOREIGN_INTEGER) IRTLM_FI(1)
      TYPE(FOREIGN_REAL) PENE_OLDFI(1),STIF_OLDFI(1)
      TYPE(LOCAL_STORAGE) INTBUF_TAB
      INTEGER I,N,JG,JLT,NSN,NIN,INACTI,IVIS2,JLT_NEW,
     . CAND_N(CAPACITY),CAND_N_N(CAPACITY),NSVG(CAPACITY),
     . IRTLM(4,CAPACITY)
      REAL(C_DOUBLE) PENE(CAPACITY),STIF(CAPACITY),
     . PENE_OLD(5,CAPACITY),PENE_SHFT
      JLT=COUNT
      NSN=ROWS
      NIN=1
      INACTI=5
      IVIS2=1
      JLT_NEW=0
      IRTLM=0
      PENE_OLD=ZERO
      INTBUF_TAB%STIF_OLD=ZERO
      DO N=1,ROWS
        IRTLM(1,N)=MARKERS(N)
        PENE_OLD(5,N)=OFFSETS(N)
        INTBUF_TAB%STIF_OLD(2*(N-1)+1)=STAGED(N)
      ENDDO
      DO I=1,JLT
        CAND_N(I)=INDICES(I)
        CAND_N_N(I)=INDICES(I)
        NSVG(I)=1
        PENE(I)=INPUT_P(I)
        STIF(I)=INPUT_K(I)
      ENDDO
@OFFSETS@
@STIFFNESS@
      OUT_P(1:JLT)=PENE(1:JLT)
      DO N=1,ROWS
        OUT_OFFSETS(N)=PENE_OLD(5,N)
        OUT_STAGED(N)=INTBUF_TAB%STIF_OLD(2*(N-1)+1)
      ENDDO
      END SUBROUTINE
