! SPDX-License-Identifier: AGPL-3.0-or-later
! Source-shaped arrays around original IN24, I25SURFI blocks and full SH2.
      SUBROUTINE RD_INTERFACE_SOURCE(COUNTS,X,SNODES,QNODES,TNODES,
     . RAW_NODES,RAW_ROLES,RAW_ELEMS,CLASSIFIED,MATCHED,FLAGS,
     . OUT_COUNTS,PRIMARY_NODES,PRIMARY_ROLES,WINNER,RAW_PRIMARY,
     . EXPANDED_NODES,EXPANDED_ROLES) BIND(C)
      USE ISO_C_BINDING
      USE INTERFACE_NATIVE_OBSERVATION
      IMPLICIT NONE
#include "com04_c.inc"
      INTEGER(C_INT),INTENT(IN)::COUNTS(5),SNODES(8,*),
     . QNODES(4,*),TNODES(3,*),RAW_NODES(4,*),RAW_ROLES(*),
     . RAW_ELEMS(*)
      REAL(C_DOUBLE),INTENT(IN)::X(3,*)
      INTEGER(C_INT),INTENT(OUT)::CLASSIFIED(256),MATCHED(256),
     . FLAGS(64),OUT_COUNTS(3),PRIMARY_NODES(4,256),
     . PRIMARY_ROLES(256),WINNER(256),RAW_PRIMARY(256),
     . EXPANDED_NODES(4,512),EXPANDED_ROLES(512)
      INTEGER IXS(11,64),IXS10(6,1),IXS16(8,1),IXS20(12,1),
     . IXC(7,64),IXTG(6,64),IXTG1(4,1),KNOD2ELS(257),NOD2ELS(512),
     . KNOD2ELC(257),NOD2ELC(256),KNOD2ELTG(257),NOD2ELTG(192),
     . KNOD2ELQ(257),NOD2ELQ(1),IXQ(7,1)
      INTEGER IRECTMP(6,256),IRECTMP_SAV(6,256),INDEX(512),
     . WORK(70000),IRECT(4,512),MSEGTYP(512),MBINFLG(512),
     . FLAG_ELEM_INTER25(1,64)
      INTEGER I,J,K,L,N,ISU1,ILEV,IMBIN,NIN25,ELEM,NRTM,NRTMP,
     . NRTM_SH,IDEB,I1,I2,IMIN,IJ,MODE,P,G,BITSET
      LOGICAL LINE_SEG,LINE_SEG_M
      TYPE(INTERFACE_SURFACE) IGRSURF(1)
      NUMNOD=COUNTS(1)
      NUMELS=COUNTS(2)
      NUMELS8=NUMELS
      NUMELS10=0
      NUMELS16=0
      NUMELS20=0
      NUMELC=COUNTS(3)
      NUMELTG=COUNTS(4)
      NUMELTG6=0
      NUMELQ=0
      NUMELTRIA=0
      NUMELT=0
      NUMELP=0
      NUMELR=0
      NPART=0
      IXS=0
      IXS10=0
      IXS16=0
      IXS20=0
      IXC=0
      IXTG=0
      IXTG1=0
      IXQ=0
      KNOD2ELS=0
      NOD2ELS=0
      KNOD2ELC=0
      NOD2ELC=0
      KNOD2ELTG=0
      NOD2ELTG=0
      KNOD2ELQ=0
      NOD2ELQ=0
      DO I=1,NUMELS
        IXS(2:9,I)=SNODES(:,I)
      ENDDO
      DO I=1,NUMELC
        IXC(2:5,I)=QNODES(:,I)
      ENDDO
      DO I=1,NUMELTG
        IXTG(2:4,I)=TNODES(:,I)
      ENDDO
@CNEL_COUNTS@
@CNEL_FILL@
      IGRSURF(1)%NSEG=COUNTS(5)
      DO I=1,COUNTS(5)
        IGRSURF(1)%NODES(I,:)=RAW_NODES(:,I)
        IGRSURF(1)%ELTYP(I)=RAW_ROLES(I)
        IGRSURF(1)%ELEM(I)=RAW_ELEMS(I)
      ENDDO
      CLASSIFIED=0
      MATCHED=0
      FLAGS=0
      OUT_COUNTS=0
      PRIMARY_NODES=0
      PRIMARY_ROLES=0
      WINNER=0
      RAW_PRIMARY=0
      EXPANDED_NODES=0
      EXPANDED_ROLES=0
      IRECTMP=0
      IRECTMP_SAV=0
      IRECT=0
      MSEGTYP=0
      MBINFLG=0
      FLAG_ELEM_INTER25=0
      INDEX=0
      WORK=0
      ISU1=1
      ILEV=1
      IMBIN=0
      NIN25=1
      LINE_SEG=.FALSE.
      LINE_SEG_M=.FALSE.
      L=0
      NRTM=COUNTS(5)
@RAW_CLASSIFICATION@
      CLASSIFIED(1:COUNTS(5))=IRECTMP(5,1:COUNTS(5))
      FLAGS(1:NUMELS)=FLAG_ELEM_INTER25(1,1:NUMELS)
      NRTMP=NRTM
@FILTER_KEYS@
@FILTER_COUNTS@
      P=NRTM
      G=P+NRTM_SH
      OUT_COUNTS=[P,NRTM_SH,G]
@FILTER_OUTPUT@
      IF(NRTM/=P) ERROR STOP 'Native allocation/fill filter disagreed'
      PRIMARY_NODES(:,1:P)=IRECT(:,1:P)
      PRIMARY_ROLES(1:P)=MSEGTYP(1:P)
      CALL SH2SURF25(P,IRECT,0,MBINFLG,MSEGTYP,G)
      EXPANDED_NODES(:,1:G)=IRECT(:,1:G)
      EXPANDED_ROLES(1:G)=MSEGTYP(1:G)
      END
