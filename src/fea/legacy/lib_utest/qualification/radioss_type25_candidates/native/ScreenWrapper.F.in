      SUBROUTINE RD_NATIVE_SCREEN(X,CONTROLS,INCLUDED) BIND(C)
      USE ISO_C_BINDING
      USE PEN3_CONSTANTS
      IMPLICIT NONE
      REAL(C_DOUBLE), INTENT(IN) :: X(3,5),CONTROLS(7)
      INTEGER(C_INT), INTENT(OUT) :: INCLUDED
      INTEGER M1,M2,M3,M4,NN,JJ,NE
      REAL(C_DOUBLE) XX1,XX2,XX3,XX4,YY1,YY2,YY3,YY4,
     + ZZ1,ZZ2,ZZ3,ZZ4,XMAXE,XMINE,YMAXE,YMINE,ZMAXE,ZMINE,
     + SX,SY,SZ,S2,XS,YS,ZS,AAA,D1X,D1Y,D1Z,D2X,D2Y,D2Z,
     + DD1,DD2,D2,A2,MARGE,CURV_MAX(1),GAP_S(1),GAP_M(1),
     + DGAPLOAD,DRAD,VMAXDT
      M1=1
      M2=2
      M3=3
      M4=4
      NN=5
      JJ=1
      NE=1
      MARGE=CONTROLS(1)
      CURV_MAX(1)=CONTROLS(2)
      GAP_S(1)=CONTROLS(3)
      GAP_M(1)=CONTROLS(4)
      DGAPLOAD=CONTROLS(5)
      DRAD=CONTROLS(6)
      VMAXDT=CONTROLS(7)
      INCLUDED=0
@@BOUNDS@@
@@PAIR@@
@@SCREEN@@
      INCLUDED=1
  200 CONTINUE
      END
