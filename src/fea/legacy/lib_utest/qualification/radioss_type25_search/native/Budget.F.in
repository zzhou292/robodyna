      SUBROUTINE RD_SEARCH_BUDGET(BOXES,GAP,MARGIN,PREVIOUS_DT,
     .                            FORCE_SORT,RESULT,LEVEL) BIND(C)
      USE ISO_C_BINDING
      USE SEARCH_CONSTANTS
      USE SEARCH_MPI_BOUNDARY
      IMPLICIT NONE
      REAL(C_DOUBLE), INTENT(IN) :: BOXES(6,4),GAP,MARGIN,PREVIOUS_DT
      INTEGER(C_INT), INTENT(IN) :: FORCE_SORT
      REAL(C_DOUBLE), INTENT(OUT) :: RESULT(6)
      INTEGER(C_INT), INTENT(OUT) :: LEVEL
      TYPE :: LOCAL_BUFFER
        REAL(C_DOUBLE) VARIABLES(32)
        LOGICAL BELONGS_TO_COMM_CRIT
        INTEGER MPI_COMM_CRIT,NSV(1),MSR(1)
        REAL(C_DOUBLE) STFNS(1)
      END TYPE
      TYPE(LOCAL_BUFFER) INTBUF_TAB(1)
      INTEGER I,J,JJ,NSN,NMN,JMAX,ISPMD,ISTDO,IOUT,ERRORS,KFORSMS
      INTEGER IPARI(105,1),ITAB(1),DEBUG(3),KEY,KEYIN,NCYCLE,NUMNOD
      INTEGER, PARAMETER :: SPMD_MAX=1
      LOGICAL FORCE_COMPUTATION(1)
      REAL(C_DOUBLE) XSLV(18,1),XMSR(12,1),VSLV(6,1),VMSR(6,1)
      REAL(C_DOUBLE) MAXDGAP(1),V(3,1),XX,XY,XZ,D0,VX,VY,VZ,VV
      REAL(C_DOUBLE) TZINFL,GAPSUP,VMAXDT,MARGE0,DIST0,DT1,D1,DGLOB,TT
      I=1
      IPARI=0
      ITAB=1
      DEBUG=0
      V=ZERO
      NCYCLE=0
      TT=ZERO
      NUMNOD=1
      NSN=0
      NMN=0
      ISPMD=1 ! Suppress I/O only; MPI branch is disabled below.
      ISTDO=6
      IOUT=6
      ERRORS=0
      KFORSMS=FORCE_SORT
      FORCE_COMPUTATION=.FALSE.
      INTBUF_TAB(1)%VARIABLES=ZERO
      INTBUF_TAB(1)%VARIABLES(25)=MARGIN
      INTBUF_TAB(1)%BELONGS_TO_COMM_CRIT=.FALSE.
      INTBUF_TAB(1)%MPI_COMM_CRIT=0
      DT1=PREVIOUS_DT
      MAXDGAP(1)=GAP
      XSLV=ZERO
      XMSR=ZERO
      XSLV(1:6,1)=BOXES(:,1)
      XMSR(1:6,1)=BOXES(:,2)
      VSLV(:,1)=BOXES(:,3)
      VMSR(:,1)=BOXES(:,4)
@BODY@
      RESULT(1)=D0
      RESULT(2)=VV
      RESULT(3)=VMAXDT
      RESULT(4)=INTBUF_TAB(1)%VARIABLES(24)
      RESULT(5)=DIST0
      RESULT(6)=INTBUF_TAB(1)%VARIABLES(5)
      LEVEL=0
      IF(VMAXDT>TWO*MARGE0) LEVEL=1
      IF(ERRORS>0) LEVEL=2
      END
