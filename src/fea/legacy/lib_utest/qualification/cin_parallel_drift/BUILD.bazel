load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_test")

cc_library(
    name = "fixture",
    testonly = True,
    hdrs = ["Fixture.h", "FrozenOrientation.h", "FrozenDrift.h", "FrozenTail.cuh", "DeviceFixture.cuh"],
    deps = ["//lib_utest/qualification/cin_parallel_recovery:fixture"],
)
cc_test(
    name = "host",
    size = "small",
    srcs = ["HostTest.cpp"],
    deps = [":fixture"],
    copts = ["-std=c++17", "-Ilib_src/solvers", "-fno-fast-math", "-ffp-contract=off"],
)
cuda_test(
    name = "cuda",
    size = "small",
    srcs = ["CallerTest.cu", "TailTest.cu", "Frozen.cu",
            "//lib_utest/qualification/cin_parallel_recovery:owner_test_source",
            "//lib_utest/qualification/cin_parallel_ordinary:device_packet_sources"],
    deps = [":fixture"],
    copts = ["--std=c++17", "-Ilib_src/solvers", "--fmad=false", "--prec-div=true",
             "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    tags = ["exclusive", "gpu"],
)
