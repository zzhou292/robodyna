! SPDX-License-Identifier: AGPL-3.0-or-later
! Source-shaped bounded serial I25STI3/I25INI_GAP_N fixture, IGAP1/ILEV1.
      SUBROUTINE RD_GAP_SOURCE(COUNTS,MODE,SCALE,
     . SHN,SHV,TN,TV,BN,BV,RN,RT,RV,MAINS,ROLES,SN,MN,
     . SECONDARY,MAIN_NODES,CORNERS,MAXIMUM,EXTREMA) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
@CONSTANTS@
      INTEGER(C_INT),INTENT(IN) :: COUNTS(10),MODE
      REAL(C_DOUBLE),INTENT(IN) :: SCALE(3)
      INTEGER(C_INT),INTENT(IN) :: SHN(4,*),TN(2,*),BN(2,*),RN(2,*)
      INTEGER(C_INT),INTENT(IN) :: RT(*),MAINS(4,*),ROLES(*),SN(*),MN(*)
      REAL(C_DOUBLE),INTENT(IN) :: SHV(3,*),TV(2,*),BV(2,*),RV(*)
      REAL(C_DOUBLE),INTENT(OUT) :: SECONDARY(*),MAIN_NODES(*),CORNERS(4,*),MAXIMUM(*),EXTREMA(2)
      INTEGER NUMNOD,NUMELC,NUMELTG,NUMELT,NUMELP,NUMELR,NSN,NRTM,NRT,NMN
      INTEGER I,J,K,MG,IP,IGTYP,NN,NS,M,IW,I1,I2,I3
      INTEGER ILEV,IGAP,IINTTHICK,ITHK25,GI
      INTEGER IXC(6,32),IXTG(5,32),IXT(4,16),IXP(5,16),IXR(4,16)
      INTEGER IPARTC(32),IPARTTG(32),IPARTT(16),IPARTP(16),IPARTR(16)
      INTEGER IGEO(12,128),IRECT(4,64),MSEGTYP(64),NSV(32),MSR(32),TAGB(32)
      REAL(C_DOUBLE) GEO(1,128),THK(32),THK_PART(128),WA(32)
      REAL(C_DOUBLE) GAP_S(32),GAP_M(64),GAP_N(4,64),GAPN_M(32),GAPMSAV(64)
      REAL(C_DOUBLE) GAP_S_L(32),DX,THK_S,THK_M,THK_S_SCALE,THK_M_SCALE
      REAL(C_DOUBLE) GAPSCALE,GAPMAX_S,GAPMAX_M,GAPS_MX,GAPS_MN,GAPS_L_MX,GAPS_L_MN
      NUMNOD=COUNTS(1)
      NUMELC=COUNTS(2)
      NUMELTG=COUNTS(3)
      NUMELT=COUNTS(4)
      NUMELP=COUNTS(5)
      NUMELR=COUNTS(6)
      NSN=COUNTS(7)
      NRTM=COUNTS(8)
      NRT=COUNTS(9)
      NMN=COUNTS(10)
      ILEV=1
      IGAP=1
      ITHK25=0
      IINTTHICK=MODE
      GAPSCALE=SCALE(1)
      GAPMAX_S=SCALE(2)
      GAPMAX_M=SCALE(3)
      THK_S=ZERO
      THK_M=ZERO
      THK_S_SCALE=ONE
      THK_M_SCALE=ONE
      IXC=0
      IXTG=0
      IXT=0
      IXP=0
      IXR=0
      IGEO=0
      THK=ZERO
      THK_PART=ZERO
      GEO=ZERO
      GAP_S_L=ZERO
      GI=0
      DO I=1,NUMELC+NUMELTG
        GI=GI+1
        GEO(1,GI)=SHV(3,I)
        THK_PART(GI)=SHV(1,I)
        THK(I)=SHV(2,I)
        IGEO(11,GI)=1
        IF(I<=NUMELC)THEN
          IXC(2:5,I)=SHN(:,I)
          IXC(6,I)=GI
          IPARTC(I)=GI
        ELSE
          J=I-NUMELC
          IXTG(2:4,J)=SHN(1:3,I)
          IXTG(5,J)=GI
          IPARTTG(J)=GI
        ENDIF
      ENDDO
      DO I=1,NUMELT
        GI=GI+1
        IXT(2:3,I)=TN(:,I)
        IXT(4,I)=GI
        IPARTT(I)=GI
        THK_PART(GI)=TV(1,I)
        GEO(1,GI)=TV(2,I)
      ENDDO
      DO I=1,NUMELP
        GI=GI+1
        IXP(2:3,I)=BN(:,I)
        IXP(5,I)=GI
        IPARTP(I)=GI
        THK_PART(GI)=BV(1,I)
        GEO(1,GI)=BV(2,I)
      ENDDO
      DO I=1,NUMELR
        GI=GI+1
        IXR(1,I)=GI
        IXR(2:3,I)=RN(:,I)
        IPARTR(I)=GI
        THK_PART(GI)=RV(I)
        IGEO(11,GI)=RT(I)
      ENDDO
      IRECT(:,1:NRTM)=MAINS(:,1:NRTM)
      MSEGTYP(1:NRTM)=ROLES(1:NRTM)
      NSV(1:NSN)=SN(1:NSN)
      MSR(1:NMN)=MN(1:NMN)
      GAPS_MN=EP30
      GAPS_MX=ZERO
      GAPS_L_MN=EP30
      GAPS_L_MX=ZERO
@SECONDARY@
@EXTREMA@
      SECONDARY(1:NSN)=GAP_S(1:NSN)
      EXTREMA=(/GAPS_MN,GAPS_MX/)
@MAIN@
      MAIN_NODES(1:NMN)=GAPN_M(1:NMN)
      CORNERS(:,1:NRTM)=GAP_N(:,1:NRTM)
      MAXIMUM(1:NRTM)=GAP_M(1:NRTM)
      END SUBROUTINE
