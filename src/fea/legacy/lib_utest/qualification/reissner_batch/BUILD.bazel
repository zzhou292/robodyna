load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

cuda_library(
    name = "prescribed_reissner_batch",
    testonly = True,
    srcs = ["PrescribedShellBatch.cu"],
    hdrs = ["PrescribedShellBatch.h"],
    copts = [
        "--std=c++17",
        "--fmad=false",
        "--prec-div=true",
        "--prec-sqrt=true",
        "--ftz=false",
        "-Xcompiler=-fno-fast-math,-ffp-contract=off",
    ],
    tags = ["manual"],
    deps = ["//lib_src/elements:reissner_shell_force"],
)

# Compile-time choice only; never link both wrapper libraries into one binary.
cuda_library(
    name = "prescribed_reissner_ans_rows_batch",
    testonly = True,
    srcs = ["PrescribedShellBatch.cu"],
    hdrs = ["PrescribedShellBatch.h", "ReissnerShellForceAnsRows.h"],
    copts = [
        "--std=c++17",
        "-DTL_PRESCRIBED_FORCE_ANS_ROWS=1",
        "--fmad=false",
        "--prec-div=true",
        "--prec-sqrt=true",
        "--ftz=false",
        "-Xcompiler=-fno-fast-math,-ffp-contract=off",
    ],
    tags = ["manual"],
    deps = ["//lib_src/elements:reissner_shell_force"],
)

cuda_library(
    name = "prescribed_reissner_gauss_contract_batch",
    testonly = True,
    srcs = ["PrescribedShellBatch.cu"],
    hdrs = [
        "PrescribedShellBatch.h",
        "ReissnerShellForceAnsRows.h",
        "ReissnerGaussContraction.h",
        "ReissnerShellForceGaussContract.h",
    ],
    copts = [
        "--std=c++17",
        "-DTL_PRESCRIBED_FORCE_GAUSS_CONTRACT=1",
        "--fmad=false",
        "--prec-div=true",
        "--prec-sqrt=true",
        "--ftz=false",
        "-Xcompiler=-fno-fast-math,-ffp-contract=off",
    ],
    tags = ["manual"],
    deps = ["//lib_src/elements:reissner_shell_force"],
)
