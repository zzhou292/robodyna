! SPDX-License-Identifier: AGPL-3.0-or-later
! Qualification wrapper only. @BLOCKS@ are verbatim pinned I25FOR3 statements.
      SUBROUTINE RD_TYPE25_NORMAL(ENGINE,VISC,INPUT,HISTORY,OUTPUT,
     .                           TERMS,SLOT_KIND) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      TYPE, BIND(C) :: INPUT_PACKET
        REAL(C_DOUBLE) PENETRATION, STIFFNESS, NORMAL_VELOCITY
        REAL(C_DOUBLE) DT, TIME, SECONDARY_MASS
        REAL(C_DOUBLE) MAIN_MASS(4), WEIGHTS(4), FRICTION_VISCOSITY
      END TYPE
      TYPE, BIND(C) :: HISTORY_PACKET
        REAL(C_DOUBLE) PREVIOUS_PENETRATION, PREVIOUS_STIFFNESS
        REAL(C_DOUBLE) STAGED_PENETRATION, STAGED_STIFFNESS
        REAL(C_DOUBLE) DAMPING_HALF_FORCE
      END TYPE
      INTEGER(C_INT), INTENT(IN) :: ENGINE(3),SLOT_KIND
      REAL(C_DOUBLE), INTENT(IN) :: VISC
      TYPE(INPUT_PACKET), INTENT(IN) :: INPUT
      TYPE(HISTORY_PACKET), INTENT(IN) :: HISTORY
      REAL(C_DOUBLE), INTENT(OUT) :: OUTPUT(18)
      INTEGER(C_INT), INTENT(OUT) :: TERMS
@CONSTANTS@
      TYPE :: FOREIGN_HISTORY
        REAL(C_DOUBLE) P(5,1)
      END TYPE
      TYPE(FOREIGN_HISTORY) PENE_OLDFI(1), STIF_OLDFI(1)
      INTEGER JLT,I,JG,N,NIN,KDTINT,IDTMINS,IDTMINS_INT,IVIS2
      INTEGER NSVG(1),CAND_N_N(1),IX1(1),IX2(1),IX3(1),IX4(1)
      REAL(C_DOUBLE) PENE(1),STIF(1),STIF0(1),VN(1),DPENE(1)
      REAL(C_DOUBLE) PENE_OLD(5,1),STIF_OLD(2,1),FNI(1),FF(1)
      REAL(C_DOUBLE) H1(1),H2(1),H3(1),H4(1),MS(4),MSI(1)
      REAL(C_DOUBLE) VIS2(1),VISCFFRIC(1),C(1),KT(1),CF(1),OBS_C(1)
      REAL(C_DOUBLE) TT,DT1,DT1INV,EPP,RP1,RP2,STIGLO
      REAL(C_DOUBLE) ECONTT,ECONTDT,FORCEK,MAS2,FAC,VIS
      REAL(C_DOUBLE) STIFADH,SIGMAXADH,AREAS(1),BASE_ADH(1)
      REAL(C_DOUBLE) VISCADHFACT,VISCFLUID,GAPV(1)
      JLT=1
      NIN=1
      IVIS2=1
      STIGLO=-ONE
      EPP=EM10
      KDTINT=ENGINE(1)
      IDTMINS=ENGINE(2)
      IDTMINS_INT=ENGINE(3)
      TT=INPUT%TIME
      DT1=INPUT%DT
      DT1INV=ZERO
      IF(DT1>ZERO) DT1INV=ONE/DT1
      PENE(1)=INPUT%PENETRATION
      STIF(1)=INPUT%STIFFNESS
      STIF0(1)=STIF(1)
      VN(1)=INPUT%NORMAL_VELOCITY
      H1(1)=INPUT%WEIGHTS(1)
      H2(1)=INPUT%WEIGHTS(2)
      H3(1)=INPUT%WEIGHTS(3)
      H4(1)=INPUT%WEIGHTS(4)
      VISCFFRIC(1)=INPUT%FRICTION_VISCOSITY
      MSI(1)=INPUT%SECONDARY_MASS
      MS=INPUT%MAIN_MASS
      IX1=1
      IX2=2
      IX3=3
      IX4=4
      NSVG=SLOT_KIND
      CAND_N_N=1
      PENE_OLD=ZERO
      STIF_OLD=ZERO
      PENE_OLD(1,1)=HISTORY%STAGED_PENETRATION
      PENE_OLD(2,1)=HISTORY%PREVIOUS_PENETRATION
      PENE_OLD(3,1)=HISTORY%DAMPING_HALF_FORCE
      STIF_OLD(1,1)=HISTORY%STAGED_STIFFNESS
      STIF_OLD(2,1)=HISTORY%PREVIOUS_STIFFNESS
      PENE_OLDFI(1)%P=PENE_OLD
      STIF_OLDFI(1)%P=ZERO
      STIF_OLDFI(1)%P(1:2,:)=STIF_OLD
      FNI=ZERO
      FF=ZERO
      C=ZERO
      KT=ZERO
      CF=ZERO
      OBS_C=ZERO
      ECONTT=ZERO
      ECONTDT=ZERO
      TERMS=0
      I=1
      IF(PENE(I)==ZERO) THEN
@ZERO@
      ENDIF
@HISTORY@
@SPRING@
      FORCEK=STIF(1)
      IF(PENE(1)==ZERO) FORCEK=ZERO
@ENERGY@
@DAMPING@
@WORK@
      OUTPUT(1)=HISTORY%PREVIOUS_PENETRATION
      OUTPUT(2)=HISTORY%PREVIOUS_STIFFNESS
      IF(SLOT_KIND>0) THEN
        OUTPUT(3)=PENE_OLD(1,1)
        OUTPUT(4)=STIF_OLD(1,1)
        OUTPUT(5)=PENE_OLD(3,1)
      ELSE
        OUTPUT(3)=PENE_OLDFI(1)%P(1,1)
        OUTPUT(4)=STIF_OLDFI(1)%P(1,1)
        OUTPUT(5)=PENE_OLDFI(1)%P(3,1)
      ENDIF
      OUTPUT(6)=H1(1)
      OUTPUT(7)=H2(1)
      OUTPUT(8)=H3(1)
      OUTPUT(9)=H4(1)
      OUTPUT(10)=FORCEK
      OUTPUT(11)=STIF(1)
      OUTPUT(12)=FNI(1)
      OUTPUT(13)=ECONTT
      OUTPUT(14)=FF(1)
      OUTPUT(15)=ECONTDT
      OUTPUT(16)=OBS_C(1)
      OUTPUT(17)=KT(1)
      OUTPUT(18)=CF(1)
      IF(PENE(1)/=ZERO.AND.(VISC/=ZERO.OR.VISCFFRIC(1)/=ZERO))
     . TERMS=MERGE(0,1,KDTINT==0.AND.
     .                    (IDTMINS/=2.AND.IDTMINS_INT==0))
      END SUBROUTINE
