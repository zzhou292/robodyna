! SPDX-License-Identifier: AGPL-3.0-or-later
! Bounded early-reader tables and inverse PART roster, followed by full donors.
      SUBROUTINE RD_SURFACE_SOURCE(COUNTS,SNODES,QNODES,TNODES,PIDS,
     . PARTS,SELECTED,NFACE,FACES,FLAGS) BIND(C)
      USE ISO_C_BINDING
      USE SETDEF_MOD
      USE INVERTED_GROUP_MOD
      USE SET_SCRATCH_MOD
      USE NAMES_AND_TITLES_MOD
      USE RD_SURFACE_OBSERVATION
      IMPLICIT NONE
#include "com04_c.inc"
#include "scr17_c.inc"
#include "remesh_c.inc"
      INTEGER(C_INT),INTENT(IN)::COUNTS(10),SNODES(8,*),QNODES(4,*),
     . TNODES(3,*),PIDS(64,3),PARTS(*),SELECTED(*)
      INTEGER(C_INT),INTENT(OUT)::NFACE,FACES(8,512),FLAGS(64)
      INTEGER IXS(11,64),IXS10(6,1),IXS20(12,1),IXS16(8,1),
     . IXC(7,64),IXTG(6,64),IXTG1(4,1),IXQ(7,1),IPART(1,256),
     . IPARTS(64),IPARTC(64),IPARTG(64),IPARTQ(1),SH4TREE(1),SH3TREE(1)
      INTEGER KNOD2ELS(257),NOD2ELS(512),KNOD2ELC(257),NOD2ELC(256),
     . KNOD2ELTG(257),NOD2ELTG(192),KNOD2ELQ(257),NOD2ELQ(1)
      INTEGER I,J,K,N,L,ORDINAL,OPT_A,OPT_O,OPT_E
      REAL(C_DOUBLE) X(3,256)
      TYPE(SET_) CLAUSE
      TYPE(SET_SCRATCH) DELBUF
      TYPE(INVERTGROUP_STRUCT_) INV_GROUP
      CHARACTER(LEN=NCHARFIELD) KEYSET
      NUMNOD=COUNTS(1)
      NUMELS=COUNTS(2)
      NUMELS8=NUMELS
      NUMELS10=0
      NUMELS16=0
      NUMELS20=0
      NUMELC=COUNTS(3)
      NUMELTG=COUNTS(4)
      NPART=COUNTS(5)
      NUMELTG6=0
      NUMELQ=0
      NUMELTRIA=0
      NUMELT=0
      NUMELP=0
      NUMELR=0
      NADMESH=0
      KSH4TREE=0
      KSH3TREE=0
      LIPART1=1
      IXS=0
      IXC=0
      IXTG=0
      IXQ=0
      IPART=0
      IPARTQ=0
      SH4TREE=0
      SH3TREE=0
      X=0
      KNOD2ELS=0
      KNOD2ELC=0
      KNOD2ELTG=0
      KNOD2ELQ=0
      NOD2ELS=0
      NOD2ELC=0
      NOD2ELTG=0
      NOD2ELQ=0
      FLAGS=0
      FACES=0
      NFACE=0
      CALL RD_RESET()
      DO I=1,NUMELS
        IXS(2:9,I)=SNODES(:,I)
        IPARTS(I)=PIDS(I,1)
      ENDDO
      DO I=1,NUMELC
        IXC(2:5,I)=QNODES(:,I)
        IPARTC(I)=PIDS(I,2)
      ENDDO
      DO I=1,NUMELTG
        IXTG(2:4,I)=TNODES(:,I)
        IPARTG(I)=PIDS(I,3)
      ENDDO
@CNEL_COUNTS@
@CNEL_FILL@
      IF(COUNTS(6)==0) THEN
        KEYSET='PART'
        CLAUSE%NB_PART=COUNTS(9)
        ALLOCATE(CLAUSE%PART(CLAUSE%NB_PART))
        CLAUSE%PART=PARTS(1:CLAUSE%NB_PART)
        CALL RD_INVERSE_PART(NPART,NUMELS,IPARTS,
     .                      INV_GROUP%INDPARTS,INV_GROUP%PARTS)
        CALL RD_INVERSE_PART(NPART,NUMELC,IPARTC,
     .                      INV_GROUP%INDPARTC,INV_GROUP%PARTC)
        CALL RD_INVERSE_PART(NPART,NUMELTG,IPARTG,
     .                      INV_GROUP%INDPARTTG,INV_GROUP%PARTTG)
        CALL CREATE_ELEMENT_FROM_PART(CLAUSE,INV_GROUP,0)
      ELSE
        KEYSET='SOLID'
        CLAUSE%NB_SOLID=COUNTS(10)
        ALLOCATE(CLAUSE%SOLID(CLAUSE%NB_SOLID))
        CLAUSE%SOLID=SELECTED(1:CLAUSE%NB_SOLID)
      ENDIF
      OPT_A=0
      OPT_E=0
      OPT_O=COUNTS(8)
      IF(COUNTS(7)==3) OPT_A=1
      IF(COUNTS(7)==2) OPT_E=1
      CALL CREATE_SURFACE_FROM_ELEMENT(
     . IXS,IXS10,SH4TREE,SH3TREE,IXC,IXTG,KNOD2ELS,NOD2ELS,
     . KNOD2ELC,NOD2ELC,KNOD2ELTG,NOD2ELTG,IPARTC,IPARTG,IPARTS,
     . IPART,CLAUSE,OPT_A,OPT_O,IXQ,KNOD2ELQ,NOD2ELQ,X,KEYSET,
     . DELBUF,.FALSE.,IPARTQ,OPT_E)
      NFACE=CLAUSE%NB_SURF_SEG
      IF(NFACE/=RD_SORTED_COUNT) ERROR STOP 'Native sort observation differs'
      DO I=1,NFACE
        ORDINAL=RD_SORT_INDEX(I)
        IF(ORDINAL<1.OR.ORDINAL>NFACE) ERROR STOP 'Native permutation extent'
        FACES(1:4,I)=CLAUSE%SURF_NODES(I,:)
        FACES(5,I)=CLAUSE%SURF_ELTYP(I)
        FACES(6,I)=CLAUSE%SURF_ELEM(I)
        FACES(7,I)=RD_RAW_FACE(ORDINAL)
        FACES(8,I)=ORDINAL
        IF(FACES(5,I)==1)THEN
          IF(RD_RAW_SOLID(ORDINAL)/=FACES(6,I)) ERROR STOP 'Solid observation identity'
          FLAGS(FACES(6,I))=1
        ELSE
          IF(FACES(7,I)/=0) ERROR STOP 'Shell has solid face observation'
        ENDIF
      ENDDO
      CONTAINS
      SUBROUTINE RD_INVERSE_PART(PART_COUNT,ROW_COUNT,ROW_PART,
     .                          OFFSETS,ROWS)
      INTEGER,INTENT(IN)::PART_COUNT,ROW_COUNT,ROW_PART(*)
      INTEGER,ALLOCATABLE,INTENT(OUT)::OFFSETS(:),ROWS(:)
      INTEGER P,R,AT
      ALLOCATE(OFFSETS(PART_COUNT+1),ROWS(ROW_COUNT))
      AT=1
      DO P=1,PART_COUNT
        OFFSETS(P)=AT
        DO R=1,ROW_COUNT
          IF(ROW_PART(R)==P)THEN
            ROWS(AT)=R
            AT=AT+1
          ENDIF
        ENDDO
      ENDDO
      OFFSETS(PART_COUNT+1)=AT
      IF(AT/=ROW_COUNT+1) ERROR STOP 'Incomplete inverse PART wrapper roster'
      END SUBROUTINE
      END
