load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(["sources.bzl"])

_SOURCE = "//src/compatibility/chrono:src/chrono_cascade/"

# These retained CAD adapters create native bodies/visual shapes and deliberately
# depend on the current mixed mechanics owner. They are not neutral geometry.
cc_library(
    name = "cad",
    srcs = [_SOURCE + name for name in [
        "ChCascadeMeshTools.cpp", "ChCascadeDoc.cpp",
        "ChVisualShapeCascade.cpp", "ChBodyEasyCascade.cpp",
    ]],
    hdrs = [_SOURCE + name for name in [
        "ChApiCASCADE.h", "ChCascadeTriangulate.h", "ChCascadeMeshTools.h",
        "ChCascadeDoc.h", "ChVisualShapeCascade.h", "ChBodyEasyCascade.h",
    ]],
    strip_include_prefix = "/src/compatibility/chrono/src",
    deps = ["//build_defs/chrono:native_core_fea", "@occt_sdk//:sdk"],
    local_defines = ["CH_API_COMPILE_CASCADE", "HAVE_IOSTREAM", "HAVE_LIMITS_H"],
    copts = ["-O3", "-fPIC"],
    alwayslink = True,
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    tags = ["manual", "native-cad", "cpu-only"],
)

cc_library(
    name = "irrlicht",
    srcs = [_SOURCE + "ChCascadeIrrMeshTools.cpp"],
    hdrs = [_SOURCE + "ChCascadeIrrMeshTools.h"],
    strip_include_prefix = "/src/compatibility/chrono/src",
    deps = [":cad", "//src/visualization/irrlicht:irrlicht"],
    local_defines = ["CH_API_COMPILE_CASCADE", "HAVE_IOSTREAM", "HAVE_LIMITS_H"],
    copts = ["-O3", "-fPIC"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    tags = ["manual", "native-cad"],
)

filegroup(
    name = "demo_assets",
    srcs = ["//src/compatibility/chrono:" + path for path in [
        "data/cascade/assembly.stp",
        "data/cascade/IRB7600_23_500_m2000_rev1_01_decorated.stp",
        "data/textures/blue.png",
    ]],
)

cc_test(
    name = "native_test",
    srcs = ["CadTest.cpp"],
    args = ["$(location @occt_sdk//:resources/StdResource/Plugin)"],
    data = ["@occt_sdk//:runtime", "@occt_sdk//:resources/StdResource/Plugin"],
    deps = [":cad", "@googletest//:gtest"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "small",
    tags = ["manual", "cpu-only", "sdk-admission"],
)
