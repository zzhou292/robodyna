      SUBROUTINE RD_COATED_READER(NNODE,KIND,NODES,X,RESULT)
     . BIND(C)
      USE ISO_C_BINDING
      USE COATED_SOURCE_CONSTANTS
      USE ELEMENT_MOD
      IMPLICIT NONE
      INTEGER(C_INT),VALUE::NNODE,KIND
      INTEGER(C_INT),INTENT(IN)::NODES(8)
      REAL(C_DOUBLE),INTENT(IN)::X(3,NNODE)
      INTEGER(C_INT),INTENT(OUT)::RESULT(8)
      INTEGER IXS(NIXS,1),ISOLNOD(1),I,J,
     . IC1,IC2,IC3,IC4,IC5,IC6,IC7,IC8
      REAL(C_DOUBLE),EXTERNAL::CHECKVOLUME_8N
      IF(NNODE<1.OR.NNODE>1024)ERROR STOP 'Reader node cap'
      I=1
      IXS=0
      ISOLNOD=0
      IF(KIND==8)THEN
        IXS(2:9,1)=NODES+1
@H8_READER@
      ELSEIF(KIND==6)THEN
        IXS(2:7,1)=NODES(1:6)+1
@PENTA_READER@
      ELSE
        ERROR STOP 'Unselected reader kind'
      ENDIF
      RESULT=IXS(2:9,1)-1
      END
