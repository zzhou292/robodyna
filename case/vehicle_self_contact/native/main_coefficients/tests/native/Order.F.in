      SUBROUTINE RD_MAIN_ORDER(COUNT,KEYS,ORDER) BIND(C)
      USE ISO_C_BINDING
      IMPLICIT NONE
      INTEGER(C_INT),INTENT(IN)::COUNT,KEYS(8,*)
      INTEGER(C_INT),INTENT(OUT)::ORDER(*)
      INTEGER NUMELC,ITRI(8,64),INDEX(128),WORK(65538),MODE,I
      NUMELC=COUNT
      ITRI(:,1:COUNT)=KEYS(:,1:COUNT)
@ORDER@
      ORDER(1:COUNT)=INDEX(1:COUNT)
      END
