# All wrappers use this one implementation DSO and one class-factory instance.
# These bindings retain the current combined CPU backend; no CUDA coverage claim.
cc_shared_library(
    name = "native_core",
    deps = ["//build_defs/chrono:native_core_fea"],
    shared_lib_name = "librobodyna_core.so",
    user_link_flags = ["-Wl,-soname,librobodyna_core.so"],
    tags = ["manual", "native-bindings", "cpu-only"],
)

swig_module(
    name = "python_generated",
    language = "python",
    interface = "//src/compatibility/chrono:src/chrono_swig/chrono_python/ChModuleCore_python.i",
    sources = ["//src/compatibility/chrono:swig_source_inputs"],
)

swig_module(
    name = "csharp_generated",
    language = "csharp",
    interface = "//src/compatibility/chrono:src/chrono_swig/chrono_csharp/ChModuleCore_csharp.i",
    sources = ["//src/compatibility/chrono:swig_source_inputs"],
)

filegroup(name = "python_wrapper_source", srcs = [":python_generated"], output_group = "wrapper")
filegroup(name = "python_director_header", srcs = [":python_generated"], output_group = "directors")
filegroup(name = "python_proxy", srcs = [":python_generated"], output_group = "proxy")
filegroup(name = "csharp_wrapper_source", srcs = [":csharp_generated"], output_group = "wrapper")
filegroup(name = "csharp_director_header", srcs = [":csharp_generated"], output_group = "directors")
filegroup(name = "csharp_proxies", srcs = [":csharp_generated"], output_group = "proxy")

_WRAPPER_COPTS = ["-std=c++17", "-O3", "-fPIC", "-fno-fast-math", "-ffp-contract=off", "-Wno-unused-variable"]

cc_library(
    name = "python_wrapper",
    srcs = [":python_wrapper_source"],
    hdrs = [":python_director_header"],
    deps = ["//build_defs/chrono:native_core_fea", "@python_sdk//:headers"],
    copts = _WRAPPER_COPTS,
    tags = ["manual", "native-bindings", "cpu-only"],
)

cc_library(
    name = "csharp_wrapper",
    srcs = [":csharp_wrapper_source"],
    hdrs = [":csharp_director_header"],
    deps = ["//build_defs/chrono:native_core_fea"],
    copts = _WRAPPER_COPTS,
    tags = ["manual", "native-bindings", "cpu-only"],
)

cc_shared_library(
    name = "python_core",
    deps = [":python_wrapper"],
    dynamic_deps = [":native_core"],
    shared_lib_name = "_core.so",
    tags = ["manual", "native-bindings", "cpu-only"],
)

# Native wrapper compilation only; managed C# runtime qualification is separate.
cc_shared_library(
    name = "csharp_core",
    deps = [":csharp_wrapper"],
    dynamic_deps = [":native_core"],
    shared_lib_name = "libchrono.so",
    tags = ["manual", "native-bindings", "cpu-only"],
)

