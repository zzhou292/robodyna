load(":declaration.bzl", "declaration_view")
load(":swig.bzl", "swig_core")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

exports_files(["body_view_contract.json", "mesh_view_contract.json", "declaration_view.cmake"])

# Pins are reviewed separately from the mutable generator inputs. Keep in sync
# with the CMake contract; a source/API edit must not silently refresh these.
declaration_view(
    name = "body_declarations",
    canonical = "//include/robodyna/mbd:RbBody.h",
    canonical_path = "include/robodyna/mbd/RbBody.h",
    original_path = "src/compatibility/chrono/src/chrono/physics/ChBody.h",
    view_name = "BodyDeclarations.h",
    forwarder = "//src/compatibility/chrono:src/chrono/physics/ChBody.h",
    ledger = "//docs/migration:BODY_TRANSFORMATIONS.json",
    original_sha256 = "6f1d415ad43ca60f4026db79096c7439d35e139edcdc405f18caafdd276ac3c2",
    ledger_sha256 = "fab2eb3c4a7a7a09c67afa754ac01322d3b0bdd3835c6f752f65c5d51d98df82",
)

filegroup(name = "body_header", srcs = [":body_declarations"], output_group = "header")

declaration_view(
    name = "mesh_declarations",
    canonical = "//include/robodyna/fea:RbMesh.h",
    canonical_path = "include/robodyna/fea/RbMesh.h",
    forwarder = "//src/compatibility/chrono:src/chrono/fea/ChMesh.h",
    original_path = "src/compatibility/chrono/src/chrono/fea/ChMesh.h",
    view_name = "MeshDeclarations.h",
    ledger = "//docs/migration:MESH_TRANSFORMATIONS.json",
    original_sha256 = "6ef39b75ba467165b0ba72ca40b8db73e6d1326e6f4f519ffe9af8c0bfb043b4",
    ledger_sha256 = "cdc1b739000701e6a25d24a88702fa57049fc17e5c432e5914f67f7947418d1f",
)

filegroup(name = "mesh_header", srcs = [":mesh_declarations"], output_group = "header")

# All wrappers use this one implementation DSO and one class-factory instance.
# These bindings retain the current combined CPU backend; no CUDA coverage claim.
cc_shared_library(
    name = "native_core",
    deps = ["//build_defs/chrono:native_core_fea"],
    shared_lib_name = "librobodyna_core.so",
    user_link_flags = ["-Wl,-soname,librobodyna_core.so"],
    tags = ["manual", "native-bindings", "cpu-only"],
)

swig_core(
    name = "python_generated",
    language = "python",
    interface = "//src/compatibility/chrono:src/chrono_swig/chrono_python/ChModuleCore_python.i",
    sources = ["//src/compatibility/chrono:swig_source_inputs"],
)

swig_core(
    name = "csharp_generated",
    language = "csharp",
    interface = "//src/compatibility/chrono:src/chrono_swig/chrono_csharp/ChModuleCore_csharp.i",
    sources = ["//src/compatibility/chrono:swig_source_inputs"],
)

filegroup(name = "python_wrapper_source", srcs = [":python_generated"], output_group = "wrapper")
filegroup(name = "python_director_header", srcs = [":python_generated"], output_group = "directors")
filegroup(name = "python_proxy", srcs = [":python_generated"], output_group = "proxy")
filegroup(name = "csharp_wrapper_source", srcs = [":csharp_generated"], output_group = "wrapper")
filegroup(name = "csharp_director_header", srcs = [":csharp_generated"], output_group = "directors")
filegroup(name = "csharp_proxies", srcs = [":csharp_generated"], output_group = "proxy")

_WRAPPER_COPTS = ["-std=c++17", "-O3", "-fPIC", "-fno-fast-math", "-ffp-contract=off", "-Wno-unused-variable"]

cc_library(
    name = "python_wrapper",
    srcs = [":python_wrapper_source"],
    hdrs = [":python_director_header"],
    deps = ["//build_defs/chrono:native_core_fea", "@python_sdk//:headers"],
    copts = _WRAPPER_COPTS,
    tags = ["manual", "native-bindings", "cpu-only"],
)

cc_library(
    name = "csharp_wrapper",
    srcs = [":csharp_wrapper_source"],
    hdrs = [":csharp_director_header"],
    deps = ["//build_defs/chrono:native_core_fea"],
    copts = _WRAPPER_COPTS,
    tags = ["manual", "native-bindings", "cpu-only"],
)

cc_shared_library(
    name = "python_core",
    deps = [":python_wrapper"],
    dynamic_deps = [":native_core"],
    shared_lib_name = "_core.so",
    tags = ["manual", "native-bindings", "cpu-only"],
)

# Native wrapper compilation only; managed C# runtime qualification is separate.
cc_shared_library(
    name = "csharp_core",
    deps = [":csharp_wrapper"],
    dynamic_deps = [":native_core"],
    shared_lib_name = "libchrono.so",
    tags = ["manual", "native-bindings", "cpu-only"],
)
