module(name = "robodyna", version = "0.1.0")

# Start with the qualified explicit backend's versions. Overrides belong to
# this product root; imported MODULE files do not select another dependency graph.
bazel_dep(name = "platforms", version = "1.0.0")
# Both the qualified inherited lock and the first root graph resolve 0.2.17.
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_cuda", version = "0.2.5")
bazel_dep(name = "rules_foreign_cc", version = "0.9.0")
bazel_dep(name = "eigen", version = "3.4.0.bcr.3")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "rules_python", version = "1.7.0")

single_version_override(
    module_name = "rules_cuda",
    version = "0.2.5",
    patches = ["//build_defs/patches:rules_cuda_0.2.5_bazel9.patch"],
    patch_strip = 1,
)
single_version_override(
    module_name = "rules_foreign_cc",
    version = "0.9.0",
    patches = ["//build_defs/patches:rules_foreign_cc_0.9.0_bazel9_v3.patch"],
    patch_strip = 1,
)
single_version_override(
    module_name = "googletest",
    version = "1.17.0",
    patches = ["//build_defs/patches:googletest_1.17.0_bazel9.patch"],
    patch_strip = 1,
)

# Transitional repository boundary preserves inherited //lib_src labels and
# include roots. This is owned, in-tree source, not a separately installed product.
local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
local_repository(name = "legacy_fea", path = "src/fea/legacy")

# A separately retained upstream dependency of the optional legacy DEM backend.
# Paths are relative to THIS root, not the ignored imported MODULE.bazel.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
new_local_repository(
    name = "dem_engine",
    path = "src/fea/legacy/third_party/DEM-Engine",
    build_file = "//build_defs/legacy:dem_engine.BUILD.bazel",
)

register_toolchains("@rules_cuda//cuda:all")

# Explicit system SDK boundary matching the inherited artifact-hash provider.
# The generated repository records resolved paths/header version; no binary is
# copied into Git and no package installation or download occurs here.
system_openssl = use_repo_rule("//build_defs/sdk:openssl.bzl", "system_openssl")
system_openssl(name = "openssl")

# Optional external rendering SDK. The frontend implementation is built from
# owned source; this repository imports no Chrono implementation library.
local_vsg = use_repo_rule("//build_defs/sdk:vsg.bzl", "local_vsg")
local_vsg(name = "vsg_sdk")

local_irrlicht = use_repo_rule("//build_defs/sdk:irrlicht.bzl", "local_irrlicht")
local_irrlicht(name = "irrlicht_sdk")

local_mumps = use_repo_rule("//build_defs/sdk:sparse.bzl", "local_mumps")
local_mumps(name = "mumps_sdk")
local_mkl = use_repo_rule("//build_defs/sdk:sparse.bzl", "local_mkl")
local_mkl(name = "mkl_sdk")

local_mono = use_repo_rule("//build_defs/sdk:mono.bzl", "local_mono")
local_mono(name = "mono_sdk")

local_roslyn = use_repo_rule("//build_defs/sdk:roslyn.bzl", "local_roslyn")
local_roslyn(name = "roslyn_sdk")

local_sensor_sdk = use_repo_rule("//build_defs/sdk:sensor.bzl", "local_sensor_sdk")
local_sensor_sdk(name = "sensor_sdk")

local_hdf5 = use_repo_rule("//build_defs/sdk:hdf5.bzl", "local_hdf5")
local_hdf5(name = "hdf5_sdk")
local_hydrochrono = use_repo_rule("//build_defs/sdk:hydrochrono.bzl", "local_hydrochrono")
local_hydrochrono(name = "hydrochrono")

local_ros = use_repo_rule("//build_defs/sdk:ros.bzl", "local_ros")
local_ros(name = "ros_sdk")

local_occt = use_repo_rule("//build_defs/sdk:occt.bzl", "local_occt")
local_occt(name = "occt_sdk")

local_urdf = use_repo_rule("//build_defs/sdk:urdf.bzl", "local_urdf")
local_urdf(name = "urdf_sdk")
local_python_embed = use_repo_rule("//build_defs/sdk:python_embed.bzl", "local_python_embed")
local_python_embed(name = "python_embed_sdk")

local_mpi = use_repo_rule("//build_defs/sdk:mpi.bzl", "local_mpi")
local_mpi(name = "mpi_sdk")

cuda_math_sdk = use_repo_rule("//build_defs/sdk:cuda_math.bzl", "cuda_math_sdk")
cuda_math_sdk(name = "cuda_math")

# The inherited modal recipe requires develop's Krylov-Schur solver. Freeze the
# actual upstream revision and archive bytes instead of tracking a moving branch.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "spectra",
    urls = ["https://github.com/yixuan/spectra/archive/c4775ea4f2bbb10f95d4c4c4b7554f6ebcf0e9e7.tar.gz"],
    sha256 = "79ae261f2a8ffa68d924c101d94bc7f092503123295d4845dd51bd12c18d5191",
    strip_prefix = "spectra-c4775ea4f2bbb10f95d4c4c4b7554f6ebcf0e9e7",
    build_file = "//build_defs/sdk:spectra.BUILD.bazel",
)

# FMI import/export support uses the retained dependency's exact source revision.
http_archive(
    name = "fmu_forge",
    type = "tar.gz",
    urls = ["https://codeload.github.com/projectchrono/fmu-forge/tar.gz/cbf2a58ba9518e6230e831ff0b3640f9a0b4905a"],
    sha256 = "56eec5cf264b357d43e2087396106517ccfd0d8a6b187ac770ecba272f94efe0",
    strip_prefix = "fmu-forge-cbf2a58ba9518e6230e831ff0b3640f9a0b4905a",
    build_file = "//src/integrations/fmi:forge.BUILD.bazel",
)

# Optional binding build SDKs are explicitly selected local installations.
# These repositories neither download tools nor install system packages.
local_swig = use_repo_rule("//build_defs/sdk:swig.bzl", "local_swig")
local_swig(name = "swig_sdk")
python_bindings_sdk = use_repo_rule("//build_defs/sdk:python_bindings.bzl", "python_bindings_sdk")
python_bindings_sdk(name = "python_sdk")

# Real optional Sensor and Vehicle dependency owners.
