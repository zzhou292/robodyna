local_fastdds = use_repo_rule("//build_defs/sdk:fastdds.bzl", "local_fastdds")
local_fastdds(name = "fastdds_sdk")

http_archive(
    name = "flatbuffers",
    urls = ["https://codeload.github.com/google/flatbuffers/tar.gz/8573108bbef495f3dd13db8353f43b2e86d25950"],
    type = "tar.gz",
    sha256 = "a492b7df3d05422070c0f369b061983f202aa92dd91b674303e8fa644b884bf1",
    strip_prefix = "flatbuffers-8573108bbef495f3dd13db8353f43b2e86d25950",
    build_file = "//build_defs/sdk:flatbuffers.BUILD.bazel",
)

local_python_plot_sdk = use_repo_rule("//build_defs/sdk:python_plot.bzl", "local_python_plot_sdk")
local_python_plot_sdk(name = "python_plot_sdk")

local_ros_interfaces = use_repo_rule("//build_defs/sdk:ros_interfaces.bzl", "local_ros_interfaces")
local_ros_interfaces(name = "ros_interfaces_sdk")

local_pythonocc_sdk = use_repo_rule("//build_defs/sdk:pythonocc.bzl", "local_pythonocc_sdk")
local_pythonocc_sdk(name = "pythonocc_sdk")
