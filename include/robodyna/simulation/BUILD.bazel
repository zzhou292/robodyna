load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["RbSystem.h", "RbSystemNSC.h", "RbSystemSMC.h", "RbSystemFwd.h"])

cc_library(
    name = "forward",
    hdrs = ["RbSystemFwd.h"],
    strip_include_prefix = "/include",
)

# The aggregate supplies inherited mechanics headers; this is not standalone composition.
cc_library(
    name = "implementation_headers",
    hdrs = ["RbSystem.h", "RbSystemNSC.h", "RbSystemSMC.h"],
    strip_include_prefix = "/include",
    deps = [":forward"],
    visibility = ["//src/compatibility/chrono:__pkg__"],
)

# This facade still uses the combined native mechanics backend.
# It does not establish independent FEA or MBD linkage.
cc_library(
    name = "api",
    hdrs = [
        "RbSystem.h",
        "RbSystemFwd.h",
        "RbSystemNSC.h",
        "RbSystemSMC.h",
        "RbAssembly.h"
    ],
    strip_include_prefix = "/include",
    deps = ["//build_defs/chrono:native_core_fea"],
)
