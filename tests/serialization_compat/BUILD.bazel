load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["FixtureIntegrityTest.py"])

cc_library(
    name = "fixture_model",
    srcs = ["ArchiveFormats.cpp", "FixtureModel.cpp"],
    hdrs = ["ArchiveFormats.h", "FixtureModel.h"],
    deps = ["//build_defs/chrono:native_core_fea"],
    copts = ["-fno-fast-math", "-ffp-contract=off"],
)

# Build/run this against the unchanged archive/factory before freezing fixtures.
cc_binary(
    name = "write_baseline",
    srcs = ["WriteBaseline.cpp"],
    deps = [":fixture_model"],
    tags = ["manual", "cpu-only"],
)

cc_test(
    name = "compatibility_test",
    srcs = ["CompatibilityTest.cpp"],
    args = ["$(location fixtures/baseline.json)"],
    data = ["fixtures/baseline.json", "fixtures/baseline.xml", "fixtures/baseline.bin"],
    deps = [":fixture_model", "@googletest//:gtest"],
    size = "small",
    tags = ["manual", "cpu-only", "serialization-compatibility"],
)

py_test(
    name = "fixture_integrity_test",
    srcs = ["FixtureIntegrityTest.py"],
    main = "FixtureIntegrityTest.py",
    args = ["$(location fixtures/manifest.json)"],
    data = ["fixtures/manifest.json", "fixtures/producer.json", "fixtures/baseline.json", "fixtures/baseline.xml", "fixtures/baseline.bin"],
    size = "small",
    tags = ["manual", "cpu-only", "serialization-compatibility"],
)

test_suite(name = "baseline_tests", tests = [":compatibility_test", ":fixture_integrity_test"])

py_test(
    name = "freeze_baseline_test",
    srcs = ["FreezeBaselineTest.py", "freeze_baseline.py"],
    main = "FreezeBaselineTest.py",
    imports = ["."],
    size = "small",
    tags = ["manual", "cpu-only", "serialization-compatibility"],
)

cc_test(
    name = "version_policy_test",
    srcs = ["VersionPolicyTest.cpp"],
    deps = ["//src/core:foundation", "@googletest//:gtest_main"],
    size = "small",
    tags = ["manual", "cpu-only", "serialization-compatibility"],
)

test_suite(
    name = "all_tests",
    tests = [":baseline_tests", ":version_policy_test", ":freeze_baseline_test", "//tests/serialization_compat/rename_probe:renamed_tests"],
)
