py_test(
    name = "ros_sensor_elf_test",
    srcs = ["ElfTest.py"], main = "ElfTest.py",
    args = ["core=$(rlocationpath " + _CORE + ")", "core_wrapper=$(rlocationpath " + _PROFILE + "csharp_core)", "sensor=$(rlocationpath " + _OPTIONAL + "native_sensor)", "sensor_wrapper=$(rlocationpath " + _PROFILE + "csharp_sensor)", "ros=$(rlocationpath " + _OPTIONAL + "native_ros)", "ros_wrapper=$(rlocationpath " + _PROFILE + "csharp_ros)"],
    data = [_CORE, _PROFILE + "csharp_core", _OPTIONAL + "native_sensor", _PROFILE + "csharp_sensor", _OPTIONAL + "native_ros", _PROFILE + "csharp_ros"],
    deps = ["//tests/bindings:elf_inspection", "@rules_python//python/runfiles"],
    target_compatible_with = select({_PROFILE + "ros_sensor_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
