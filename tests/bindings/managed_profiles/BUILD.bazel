    ],
    data = [":ros_sensor_assembly", _PROFILE + "managed_ros_sensor", _PROFILE + "csharp_ros",
            _CORE, _DATA, "@mono_sdk//:runtime", "@mono_sdk//:usr/bin/mono-sgen"],
    target_compatible_with = select({_PROFILE + "ros_sensor_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
    size = "small",
    tags = ["manual", "cpu-only", "managed-runtime"],
