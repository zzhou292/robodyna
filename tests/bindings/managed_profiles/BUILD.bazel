            _CORE, _DATA, "@mono_sdk//:runtime", "@mono_sdk//:usr/bin/mono-sgen"],
    target_compatible_with = select({_PROFILE + "sensor_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
    size = "small",
    tags = ["manual", "cpu-only", "managed-runtime"],
