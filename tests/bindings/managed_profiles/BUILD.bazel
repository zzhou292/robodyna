load("@rules_python//python:defs.bzl", "py_test")
load("//build_defs/managed:defs.bzl", "managed_assembly")

package(default_visibility = ["//visibility:public"])
_PROFILE = "//build_defs/bindings/csharp/profiles:"
_OPTIONAL = "//build_defs/bindings/optional:"
_CORE = "//build_defs/bindings:native_core"
_DATA = "//src/compatibility/chrono:data/logo_robodyna_alpha.png"

managed_assembly(
    name = "opencrg_assembly",
    assembly_name = "Robodyna.Managed.OpencrgInteropTest.exe",
    kind = "exe",
    srcs = ["Checks.cs", "OpenCrgTest.cs"],
    deps = [_PROFILE + "managed_opencrg"],
    target_compatible_with = select({_PROFILE + "opencrg_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
    tags = ["manual", "managed-runtime", "cpu-only"],
)
py_test(
    name = "opencrg_test",
    srcs = ["RuntimeTest.py"],
    main = "RuntimeTest.py",
    deps = ["//tools/managed:launcher"],
    args = [
        "--mono", "$(rlocationpath @mono_sdk//:usr/bin/mono-sgen)",
        "--assembly", "$(rlocationpath :opencrg_assembly)",
        "--managed", "$(rlocationpath " + _PROFILE + "managed_opencrg)",
        "--native-wrapper", "$(rlocationpath " + _PROFILE + "csharp_vehicle)",
        "--native-core", "$(rlocationpath " + _CORE + ")",
        "--data-anchor", "$(rlocationpath " + _DATA + ")",
        "--expect-marker", "'ROBODYNA MANAGED OPENCRG PASS'",
    ],
    data = ["//src/compatibility/chrono:data/vehicle/terrain/crg_roads/handmade_straight.crg", ":opencrg_assembly", _PROFILE + "managed_opencrg", _PROFILE + "csharp_vehicle",
            _CORE, _DATA, "@mono_sdk//:runtime", "@mono_sdk//:usr/bin/mono-sgen"],
    target_compatible_with = select({_PROFILE + "opencrg_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
    size = "small",
    tags = ["manual", "cpu-only", "managed-runtime"],
)
py_test(
    name = "opencrg_elf_test",
    srcs = ["ElfTest.py"], main = "ElfTest.py",
    args = ["core=$(rlocationpath " + _CORE + ")", "core_wrapper=$(rlocationpath " + _PROFILE + "csharp_core)", "vehicle=$(rlocationpath " + _OPTIONAL + "native_vehicle)", "vehicle_wrapper=$(rlocationpath " + _PROFILE + "csharp_vehicle)"],
    data = [_CORE, _PROFILE + "csharp_core", _OPTIONAL + "native_vehicle", _PROFILE + "csharp_vehicle"],
    deps = ["//tests/bindings:elf_inspection", "@rules_python//python/runfiles"],
    target_compatible_with = select({_PROFILE + "opencrg_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
    size = "small",
    tags = ["manual", "cpu-only", "requires-binutils"],
)

