py_test(
    name = "sensor_elf_test",
    srcs = ["ElfTest.py"], main = "ElfTest.py",
    args = ["core=$(rlocationpath " + _CORE + ")", "core_wrapper=$(rlocationpath " + _PROFILE + "csharp_core)", "sensor=$(rlocationpath " + _OPTIONAL + "native_sensor)", "sensor_wrapper=$(rlocationpath " + _PROFILE + "csharp_sensor)"],
    data = [_CORE, _PROFILE + "csharp_core", _OPTIONAL + "native_sensor", _PROFILE + "csharp_sensor"],
    deps = ["//tests/bindings:elf_inspection", "@rules_python//python/runfiles"],
    target_compatible_with = select({_PROFILE + "sensor_profile": [], "//conditions:default": ["@platforms//:incompatible"]}),
    size = "small",
    tags = ["manual", "cpu-only", "requires-binutils"],
)

