load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "startup",
    hdrs = ["QephData.h", "QephStartupFrame.h", "QephStartup.h"],
    deps = ["//lib_src/math:fixed3", "//lib_src/math:quaternion"],
)

cc_library(
    name = "kinematics",
    hdrs = [
        "QephKinematicsData.h", "QephGeometryWork.h", "QephCurrentFrame.h",
        "QephVelocityCorrection.h", "QephProjectionInverse.h", "QephProjection.h",
        "QephRates.h", "QephKinematics.h",
    ],
    deps = [":startup"],
)

cc_library(
    name = "force",
    hdrs = [
        "QephHistoryData.h", "QephHistory.h", "QephForceData.h", "QephForce.h",
        "QephMaterial.h", "QephLaw1.h", "QephElasticForces.h",
        "QephStabilizationState.h", "QephStabilizationForces.h",
        "QephForceProjection.h", "QephStiffnessDiagnostics.h",
    ],
    deps = [":kinematics", "//lib_src/materials:shell_elastic_law1"],
)

cc_library(
    name = "layered_j2",
    hdrs = ["QephLayeredJ2.h", "QephPlasticStabilization.h"],
    deps = [":force", "//lib_src/elements/sections:shell_layered_j2"],
)

cuda_library(
    name = "batch",
    srcs = [
        "QephBatch.cu", "QephBatchOperations.cu", "QephBatchKernels.cu",
        "QephBatchModel.cpp", "QephBatchIdentity.cpp", "QephBatchPublication.cpp",
        "QephBatchPlasticity.cpp", "QephBatchSections.cpp",
    ],
    hdrs = ["QephBatch.h", "QephBatchStorage.h", "QephBatchDiagnostics.h", "QephBatchStartup.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    deps = [
        ":force", ":layered_j2", ":layered_law1", "//lib_src/elements:shell_batch_fields",
        "//lib_src/elements:shell_batch_plasticity_storage",
        "//lib_src/elements:shell_batch_joined_model",
        "//lib_src/elements:shell_resident_startup_index", "//lib_src/elements:shell_resident_host_accounting",
        "//lib_src/solvers:explicit_nodal_state", "//lib_src/solvers:nodal_force_assembly",
        "//lib_src/solvers:nodal_trial_identity",
        "//lib_src/assembly:nodal_mass_binding",
        "//lib_src/solvers:nodal_native_physical_coefficients",
    ],
)

cc_library(
    name = "layered_law1",
    hdrs = ["QephLayeredLaw1.h"],
    deps = [":force", "//lib_src/elements/sections:shell_layered_law1", "//lib_src/elements/sections:shell_layered_work"],
)
