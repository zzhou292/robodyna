load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "startup",
    hdrs = ["QephData.h", "QephStartupFrame.h", "QephStartup.h"],
    deps = ["//lib_src/math:fixed3", "//lib_src/math:quaternion"],
)

cc_library(
    name = "kinematics",
    hdrs = [
        "QephKinematicsData.h", "QephGeometryWork.h", "QephCurrentFrame.h",
        "QephVelocityCorrection.h", "QephProjectionInverse.h", "QephProjection.h",
        "QephRates.h", "QephKinematics.h",
    ],
    deps = [":startup"],
)

cc_library(
    name = "force",
    hdrs = [
        "QephHistoryData.h", "QephHistory.h", "QephForceData.h", "QephForce.h",
        "QephMaterial.h", "QephLaw1.h", "QephElasticForces.h",
        "QephStabilizationState.h", "QephStabilizationForces.h",
        "QephForceProjection.h", "QephStiffnessDiagnostics.h",
    ],
    deps = [":kinematics", "//lib_src/materials:shell_elastic_law1"],
)

cuda_library(
    name = "batch",
    srcs = [
        "QephBatch.cu", "QephBatchOperations.cu", "QephBatchKernels.cu",
        "QephBatchModel.cpp", "QephBatchIdentity.cpp", "QephBatchPublication.cpp",
    ],
    hdrs = ["QephBatch.h", "QephBatchStorage.h", "QephBatchDiagnostics.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    deps = [
        ":force", "//lib_src/elements:shell_batch_fields",
        "//lib_src/elements:shell_batch_joined_model",
        "//lib_src/solvers:explicit_nodal_state", "//lib_src/solvers:nodal_force_assembly",
        "//lib_src/solvers:nodal_trial_identity",
    ],
)
