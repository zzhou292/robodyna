load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "type25_model",
    srcs = ["Type25Model.cpp"],
    hdrs = ["Type25Types.h", "Type25Capacity.h", "Type25Model.h", "Type25ModelIndex.h", "Type25Identity.h", "Type25Property.h", "Type25Frame.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/elements/spring:spring_frame_projection", "//lib_src/math:fixed3", "//lib_src/math:fixed3_operations", "//lib_utils:source_identity_index"],
)
cc_library(
    name = "type25_math",
    hdrs = ["Type25Math.h", "Type25Deformation.h", "Type25Response.h", "Type25Stability.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = ["//lib_src/elements/spring:spring_frame_projection", ":type25_model", "//lib_src/math:fixed3_operations"],
)

cuda_library(
    name = "type25_batch",
    srcs = [
        "Type25Batch.cu", "Type25BatchOperations.cu", "Type25BatchKernels.cu",
        "Type25BatchReadback.cu", "Type25BatchStartup.cpp", "Type25BatchArena.cpp",
        "Type25BatchIdentity.cpp", "Type25BatchPublication.cpp",
    ],
    hdrs = [
        "Type25Batch.h", "Type25BatchStorage.h", "Type25BatchArena.h",
        "Type25BatchIdentity.h", "Type25BatchMeasure.h",
    ],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false",
             "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [
        ":type25_math", ":type25_model", "//lib_src/assembly:nodal_mass_binding",
        "//lib_src/elements:shell_batch_fields", "//lib_src/elements:shell_batch_startup",
        "//lib_src/solvers:explicit_nodal_state", "//lib_src/solvers:nodal_force_assembly",
        "//lib_src/solvers:nodal_trial_identity", "//lib_src/solvers:nodal_native_physical_coefficients",
        "//lib_src/math:fixed3_operations", "//lib_src/math:quaternion", "//lib_utils:bounded_arena",
    ],
)
