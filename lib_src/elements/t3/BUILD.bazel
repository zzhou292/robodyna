load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "startup",
    hdrs = ["T3Data.h", "T3Geometry.h", "T3Startup.h"],
    deps = ["//lib_src/math:fixed3", "//lib_src/math:quaternion", "//lib_src/elements:shell_placement_coefficients", "//lib_src/elements:shell_reference_placement"],
)

cc_library(
    name = "kinematics",
    hdrs = ["T3KinematicsData.h", "T3CurrentGeometry.h", "T3Rates.h", "T3Kinematics.h"],
    deps = [":startup"],
)

cc_library(
    name = "force",
    hdrs = [
        "T3HistoryData.h", "T3History.h", "T3ForceData.h", "T3ForceConstants.h",
        "T3Material.h", "T3Law1.h", "T3StiffnessDiagnostics.h",
        "T3ForceProjection.h", "T3Force.h",
    ],
    deps = [":kinematics", "//lib_src/materials:shell_elastic_law1", "//lib_src/elements:shell_placement_coefficients"],
)

cc_library(
    name = "layered_j2",
    hdrs = ["T3LayeredForceCore.h", "T3LayeredJ2.h"],
    deps = [":force", "//lib_src/elements/sections:shell_layered_j2"],
)

cuda_library(
    name = "batch",
    srcs = [
        "T3Batch.cu", "T3BatchOperations.cu", "T3BatchKernels.cu",
        "T3BatchModel.cpp", "T3BatchIdentity.cpp", "T3BatchPublication.cpp",
        "T3BatchPlasticity.cpp", "T3BatchSections.cpp", "T3BatchFailure.cpp", "T3BatchFailureReadback.cpp",
    ],
    hdrs = ["T3Batch.h", "T3BatchStorage.h", "T3BatchDiagnostics.h", "T3BatchLayeredSection.h", "T3BatchFailureSection.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [
        ":force", ":layered_j2", ":layered_law1", ":layered_j2_failure", ":layered_tab1", "//lib_src/elements:shell_batch_fields",
        "//lib_src/elements:shell_batch_plasticity_storage",
        "//lib_src/elements:shell_batch_joined_model",
        "//lib_src/elements:shell_resident_startup_index", "//lib_src/elements:shell_resident_host_accounting",
        "//lib_src/solvers:explicit_nodal_state", "//lib_src/solvers:nodal_force_assembly",
        "//lib_src/solvers:nodal_trial_identity",
        "//lib_src/assembly:nodal_mass_binding",
        "//lib_src/solvers:nodal_native_physical_coefficients",
    ],
)

cc_library(
    name = "layered_law1",
    hdrs = ["T3LayeredLaw1.h"],
    deps = [":force", "//lib_src/elements/sections:shell_layered_law1", "//lib_src/elements/sections:shell_layered_work"],
)

cc_library(
    name = "layered_j2_failure",
    hdrs = ["T3LayeredJ2Failure.h"],
    deps = [":layered_j2", "//lib_src/elements/sections:shell_layered_j2_failure"],
)

cc_library(
    name = "layered_tab1",
    hdrs = ["T3LayeredTab1.h"],
    deps = [":layered_j2", "//lib_src/elements/sections:shell_layered_tab1"],
)

cc_library(
    name = "one_point_law44",
    hdrs = ["T3OnePointTypes.h", "T3OnePointHistory.h", "T3OnePointCoefficients.h",
            "T3OnePointMaterial.h", "T3OnePointForce.h"],
    deps = [":force", "//lib_src/elements/sections:shell_layered_j2",
            "//lib_src/elements/sections:shell_law44_membrane_point",
            "//lib_src/materials:law44_scope"],
)
