            "//lib_src/solvers:nodal_repeated_force_assembly",
            "//lib_src/solvers:nodal_repeated_stiffness"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false",
             "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    visibility = ["//visibility:public"],
)
