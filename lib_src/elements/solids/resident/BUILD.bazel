cuda_library(
    name = "batch",
    srcs = ["Batch.cu", "Candidate.cu", "ResultValidation.cu", "Assembly.cu", "AssembleOperation.cu",
            "EvaluateOperation.cu", "Readback.cu", "controlled/Kernel.cu", "Publication.cpp", "PublicationScope.cpp", "OutputRanges.cpp"],
    deps = [":values", "//lib_src/elements:shell_physical_owner",
