load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "shell_collection_limits",
    hdrs = ["ShellCollectionLimits.h"],
)

cc_library(
    name = "shell_batch_startup",
    hdrs = ["ShellBatchStartup.h"],
    deps = ["//lib_src/math:fixed3", "//lib_src/math:quaternion"],
)

cc_library(
    name = "shell_batch_binding",
    srcs = ["ShellBatchBinding.cpp"],
    hdrs = ["ShellBatchBinding.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":shell_collection_limits", "//lib_src/elements/qeph:startup", "//lib_src/elements/t3:startup"],
)

cc_library(
    name = "shell_batch_joined_model",
    hdrs = ["ShellBatchJoinedModel.h"],
    deps = [":shell_batch_binding"],
)

cc_library(
    name = "shell_batch_plasticity",
    hdrs = ["ShellBatchPlasticity.h"],
    deps = ["//lib_src/elements/sections:shell_layered_j2"],
)

cuda_library(
    name = "shell_batch_plasticity_storage",
    srcs = ["ShellBatchPlasticityStorage.cpp"],
    hdrs = ["ShellBatchPlasticityStorage.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [":shell_batch_plasticity", ":shell_collection_limits"],
)

cuda_library(
    name = "shell_batch_publication",
    srcs = ["ShellBatchPublication.cpp", "ShellBatchPublicationKernels.cu"],
    hdrs = ["ShellBatchPublication.h", "ShellBatchPublicationStorage.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [
        ":shell_batch_binding", ":shell_batch_fields", ":shell_batch_startup",
        ":shell_batch_plasticity_storage",
        "//lib_src/elements/qeph:batch", "//lib_src/elements/t3:batch",
        "//lib_src/solvers:explicit_nodal_state", "//lib_src/solvers:nodal_trial_identity",
    ],
)

cc_library(
    name = "shell_batch_fields",
    hdrs = ["ShellBatchFields.h"],
    # Existing family APIs consume their shared field/startup declarations
    # through this neutral boundary, preserving the pinned port BUILD files.
    deps = [":shell_batch_startup", "//lib_src/math:fixed3", "//lib_src/math:quaternion", "//lib_src/solvers:explicit_nodal_state"],
)

cc_library(
    name = "reissner_frame",
    hdrs = ["ReissnerFrame.h"],
    deps = ["//lib_src/math:quaternion", "//lib_src/math:fixed3"],
)

cc_library(
    name = "reissner_rotation",
    hdrs = ["ReissnerRotation.h"],
    deps = [":reissner_frame"],
)

cc_library(
    name = "reissner_shell_force",
    hdrs = ["ReissnerShellData.h", "ReissnerShellKinematics.h", "ReissnerShellForce.h"],
    deps = [":reissner_rotation"],
)

cc_library(
    name = "reissner_shell_mass",
    hdrs = ["ReissnerShellMass.h"],
    deps = [":reissner_shell_force"],
)

cc_library(
    name = "reissner_shell_assembly",
    hdrs = ["ReissnerShellAssembly.h"],
    deps = [":reissner_shell_force", "//lib_src/solvers:nodal_force_assembly"],
)

cuda_library(
    name = "reissner_shell_batch",
    srcs = ["ReissnerShellBatch.cu"],
    hdrs = ["ReissnerShellBatch.h", "ReissnerShellBatchStorage.h", "ReissnerShellBatchDiagnostics.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    deps = [":reissner_shell_assembly", ":reissner_shell_mass", "//lib_src/solvers:explicit_nodal_state"],
)

cuda_library(
    name = "ANCF3243Data",
    srcs = ["ANCF3243Data.cu"],
    hdrs = [
        "ANCF3243Data.cuh",
        "ANCF3243DataFunc.cuh",
        "ElementBase.h",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    # cuda_library supplies the CUDA runtime transitively. This element does
    # not invoke cuBLAS/cuSOLVER/cuSPARSE/cuDSS; those remain solver deps.
    deps = [
        "//lib_src/materials:materials",
        "//lib_utils:cpu_utils",
        "//lib_utils:cuda_runtime_utils",
        "@eigen//:eigen",
    ],
)

cuda_library(
    name = "ANCF3443Data",
    srcs = ["ANCF3443Data.cu"],
    hdrs = [
        "ANCF3443Data.cuh",
        "ANCF3443DataFunc.cuh",
        "ElementBase.h",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    linkopts = ["-lcusolver", "-lcublas", "-lcusparse"],
    deps = [
        "//lib_src/materials:materials",
        "//lib_utils:cpu_utils",
        "//lib_utils:cuda_utils",
        "@eigen//:eigen",
    ],
)

cuda_library(
    name = "FEAT10Data",
    srcs = ["FEAT10Data.cu"],
    hdrs = [
        "FEAT10Data.cuh",
        "FEAT10DataFunc.cuh",
        "ElementBase.h",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    linkopts = ["-lcusolver", "-lcublas", "-lcusparse"],
    deps = [
        "//lib_src/materials:materials",
        "//lib_utils:cpu_utils",
        "//lib_utils:cuda_utils",
        "//lib_utils:mesh_manager",
        "@eigen//:eigen",
    ],
)
