load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rigid_normal_response",
    hdrs = ["RigidNormalResponse.h", "RigidNormalResponseBounds.h"],
    deps = [":q4_contact_integration", "//lib_src/constraints:nodal_rigid_group_step_math"],
)

cuda_library(
    name = "planar_mesh_contact_device",
    srcs = ["PlanarMeshContactDevice.cu"],
    hdrs = ["PlanarMeshContact.h", "PlanarMeshContactStorage.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    deps = [":surface_contact_primitives", ":planar_wall_geometry", "//lib_src/solvers:explicit_nodal_state"],
)

cc_library(
    name = "planar_mesh_contact",
    srcs = ["PlanarMeshContact.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":planar_mesh_contact_device"],
)

cc_library(
    name = "surface_contact_primitives",
    hdrs = [
        "SurfaceContactGeometry.h",
        "SurfaceContactLaw.h",
        "SurfaceContactMass.h",
        "SurfaceContactTypes.h",
    ],
)

cc_library(
    name = "q4_surface_mapping",
    hdrs = ["Q4SurfaceMapping.h", "Q4SurfaceMass.h"],
    deps = [":surface_contact_primitives"],
)

cc_library(
    name = "planar_wall_geometry",
    srcs = ["PlanarWallGeometry.cpp", "PlanarWallBox.cpp"],
    hdrs = ["PlanarWallGeometry.h", "PlanarContactTypes.h", "PlanarWallBox.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":surface_contact_primitives"],
)

cc_library(
    name = "q4_contact_integration",
    hdrs = ["Q4ContactBounds.h", "Q4ContactIntegrationTypes.h", "Q4ContactIntegration.h", "Q4IntegralMeasure.h"],
    deps = [":q4_surface_mapping"],
)

cc_library(
    name = "prepared_planar_wall_query",
    srcs = ["PreparedPlanarWallQuery.cpp"],
    hdrs = ["PreparedPlanarWallQuery.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":planar_wall_geometry", ":q4_contact_integration"],
)

cc_library(
    name = "surface_material_measure",
    srcs = ["SurfaceMaterialMeasure.cpp"],
    hdrs = ["SurfaceMaterialMeasure.h", "SurfaceMaterialBounds.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_contact_integration"],
)

cc_library(
    name = "q4_rectangular_integration",
    hdrs = ["Q4RectangularIntegrationTypes.h", "Q4RectangularIntegration.h"],
    deps = [":q4_contact_integration"],
    tags = ["manual"],  # Explicit opt-in qualification backend; scalar stays default.
)

cc_library(
    name = "q4_planar_geometry",
    srcs = ["Q4PlanarGeometry.cpp", "Q4PlanarSweepGeometry.cpp"],
    hdrs = ["Q4PlanarGeometry.h", "Q4PlanarSweepGeometry.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":planar_wall_geometry", ":q4_contact_integration"],
)

cc_library(
    name = "prescribed_surface_interval",
    hdrs = ["PrescribedSurfaceInterval.h"],
    deps = [":planar_wall_geometry", ":q4_contact_integration"],
)

cc_library(
    name = "t3_contact_integration",
    hdrs = ["T3ContactIntegration.h", "T3ContactIntegrationTypes.h"],
    deps = [":surface_material_measure"],
)

cc_library(
    name = "q4_parametric_contact_types",
    hdrs = ["Q4ParametricContact.h"],
    deps = [":surface_material_measure", ":prescribed_surface_interval", ":q4_planar_geometry", ":q4_rectangular_integration"],
)

cc_library(
    name = "prescribed_surface_contact",
    srcs = ["PrescribedSurfaceContact.cpp"],
    hdrs = ["PrescribedSurfaceContact.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_parametric_contact_types", ":t3_contact_integration"],
)

cc_library(
    name = "q4_parametric_contact",
    srcs = ["Q4ParametricContact.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_parametric_contact_types", ":prescribed_surface_contact"],
)

cc_library(
    name = "nodal_wall_contact",
    srcs = ["NodalWallContact.cpp", "NodalWallContactEvaluation.cpp", "NodalWallWeightStartup.cpp"],
    hdrs = ["NodalWallContact.h", "NodalWallContactPoint.h", "NodalWallContactReduction.h", "NodalWallWeightLimits.h", "NodalWallWeightStartup.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_parametric_contact", "//lib_src/solvers:explicit_step_stability", "//lib_utils:bounded_startup_array", "//lib_utils:source_identity_index"],
)

cuda_library(
    name = "nodal_wall_contact_device",
    srcs = ["NodalWallContactDevice.cu"],
    hdrs = [
        "NodalWallContactDevice.h",
        "NodalWallContactStorage.h",
        "NodalWallContactArena.h",
        "NodalWallContactIncidence.h",
        "NodalWallContactState.h",
        "NodalWallContactResultIO.h",
        "NodalWallContactDiagnostics.h",
        "NodalWallContactDiagnosticIdentity.h",
        "NodalWallContactKernels.cuh",
        "NodalWallContactScatter.h",
        "NodalWallContactEvaluation.cuh",
    ],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [":nodal_wall_contact", ":prepared_planar_wall_query", "//lib_src/elements:shell_collection_limits", "//lib_src/solvers:explicit_nodal_state", "//lib_src/solvers:nodal_force_assembly", "//lib_utils:bounded_arena", "//lib_src/solvers:nodal_native_physical_coefficients"],
)

cc_library(
    name = "nodal_wall_contact_owner",
    srcs = ["NodalWallContactModel.cpp", "NodalWallContactArena.cpp", "NodalWallContactReadback.cpp", "NodalWallContactIncidence.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":nodal_wall_contact_device"],
)

cc_library(
    name = "q4_prescribed_planar_contact",
    srcs = ["Q4PrescribedPlanarContact.cpp"],
    hdrs = ["Q4PrescribedPlanarContact.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_planar_geometry", ":q4_rectangular_integration", ":prescribed_surface_interval"],
)

cc_library(
    name = "q4_planar_stiffness",
    hdrs = ["Q4PlanarStiffness.h"],
    deps = [":q4_planar_geometry"],
)

cuda_library(
    name = "q4_planar_contact_device",
    srcs = ["Q4PlanarContactDevice.cu"],
    hdrs = ["Q4PlanarContact.h", "Q4PlanarContactStorage.h", "Q4PlanarContactDiagnostics.h", "Q4PlanarContactBackend.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [":q4_planar_stiffness", ":q4_rectangular_integration", "//lib_src/solvers:explicit_nodal_state"],
)

cc_library(
    name = "q4_planar_contact",
    srcs = ["Q4PlanarContact.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_planar_contact_device"],
)

cuda_library(
    name = "hydroelastic_broadphase",
    srcs = ["HydroelasticBroadphase.cu"],
    hdrs = [
        "HydroelasticBroadphase.cuh",
        "HydroelasticBroadphaseFunc.cuh",
        "HydroelasticCollisionTypes.cuh",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    linkopts = ["-lcudart"],
    deps = [
        "//lib_utils:cpu_utils",
        "//lib_utils:cuda_utils",
        "//lib_utils:mesh_manager",
        "@eigen//:eigen",
    ],
)

cuda_library(
    name = "hydroelastic_narrowphase",
    srcs = ["HydroelasticNarrowphase.cu"],
    hdrs = [
        "HydroelasticCollisionTypes.cuh",
        "HydroelasticNarrowphase.cuh",
        "HydroelasticNarrowphaseFunc.cuh",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    linkopts = ["-lcudart"],
    deps = [
        "//lib_utils:cuda_utils",
        "@eigen//:eigen",
    ],
)

cc_library(
    name = "collision_system_interface",
    hdrs = ["CollisionSystemBase.h"],
    copts = ["--std=c++17"],
)

cc_library(
    name = "hydroelastic_patch_collision_system",
    srcs = ["HydroelasticPatchCollisionSystem.cc"],
    hdrs = ["HydroelasticPatchCollisionSystem.h"],
    copts = ["--std=c++17"],
    deps = [
        ":collision_system_interface",
        ":hydroelastic_broadphase",
        ":hydroelastic_narrowphase",
        "//lib_utils:mesh_manager",
        "@eigen//:eigen",
    ],
)

cuda_library(
    name = "deme_mesh_collision_system",
    srcs = ["DemeMeshCollisionSystem.cu"],
    hdrs = ["DemeMeshCollisionSystem.h"],
    copts = ["--std=c++17", "-O3"],
    linkopts = ["-lcudart"],
    deps = [
        ":collision_system_interface",
        "//lib_utils:cuda_utils",
        "//lib_utils:surface_trimesh",
        "@dem_engine//:dem_engine_headers",
        "//third_party:dem_engine",
        "@eigen//:eigen",
    ],
)

# Explicit complete physical/CIN source profile. Legacy device owner stays closed.
