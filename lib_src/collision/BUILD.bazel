load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cuda_library(
    name = "planar_mesh_contact_device",
    srcs = ["PlanarMeshContactDevice.cu"],
    hdrs = ["PlanarMeshContact.h", "PlanarMeshContactStorage.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false"],
    deps = [":surface_contact_primitives", ":planar_wall_geometry", "//lib_src/solvers:explicit_nodal_state"],
)

cc_library(
    name = "planar_mesh_contact",
    srcs = ["PlanarMeshContact.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":planar_mesh_contact_device"],
)

cc_library(
    name = "surface_contact_primitives",
    hdrs = [
        "SurfaceContactGeometry.h",
        "SurfaceContactLaw.h",
        "SurfaceContactMass.h",
        "SurfaceContactTypes.h",
    ],
)

cc_library(
    name = "q4_surface_mapping",
    hdrs = ["Q4SurfaceMapping.h", "Q4SurfaceMass.h"],
    deps = [":surface_contact_primitives"],
)

cc_library(
    name = "planar_wall_geometry",
    srcs = ["PlanarWallGeometry.cpp"],
    hdrs = ["PlanarWallGeometry.h", "PlanarContactTypes.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":surface_contact_primitives"],
)

cc_library(
    name = "q4_contact_integration",
    hdrs = ["Q4ContactBounds.h", "Q4ContactIntegrationTypes.h", "Q4ContactIntegration.h"],
    deps = [":q4_surface_mapping"],
)

cc_library(
    name = "q4_rectangular_integration",
    hdrs = ["Q4RectangularIntegrationTypes.h", "Q4RectangularIntegration.h"],
    deps = [":q4_contact_integration"],
    tags = ["manual"],  # Explicit opt-in qualification backend; scalar stays default.
)

cc_library(
    name = "q4_planar_geometry",
    srcs = ["Q4PlanarGeometry.cpp"],
    hdrs = ["Q4PlanarGeometry.h"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":planar_wall_geometry", ":q4_contact_integration"],
)

cc_library(
    name = "q4_planar_stiffness",
    hdrs = ["Q4PlanarStiffness.h"],
    deps = [":q4_planar_geometry"],
)

cuda_library(
    name = "q4_planar_contact_device",
    srcs = ["Q4PlanarContactDevice.cu"],
    hdrs = ["Q4PlanarContact.h", "Q4PlanarContactStorage.h", "Q4PlanarContactDiagnostics.h", "Q4PlanarContactBackend.h"],
    copts = ["--std=c++17", "--fmad=false", "--prec-div=true", "--prec-sqrt=true", "--ftz=false", "-Xcompiler=-fno-fast-math,-ffp-contract=off"],
    deps = [":q4_planar_stiffness", ":q4_rectangular_integration", "//lib_src/solvers:explicit_nodal_state"],
)

cc_library(
    name = "q4_planar_contact",
    srcs = ["Q4PlanarContact.cpp"],
    copts = ["-std=c++17", "-fno-fast-math", "-ffp-contract=off"],
    deps = [":q4_planar_contact_device"],
)

cuda_library(
    name = "hydroelastic_broadphase",
    srcs = ["HydroelasticBroadphase.cu"],
    hdrs = [
        "HydroelasticBroadphase.cuh",
        "HydroelasticBroadphaseFunc.cuh",
        "HydroelasticCollisionTypes.cuh",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    linkopts = ["-lcudart"],
    deps = [
        "//lib_utils:cpu_utils",
        "//lib_utils:cuda_utils",
        "//lib_utils:mesh_manager",
        "@eigen//:eigen",
    ],
)

cuda_library(
    name = "hydroelastic_narrowphase",
    srcs = ["HydroelasticNarrowphase.cu"],
    hdrs = [
        "HydroelasticCollisionTypes.cuh",
        "HydroelasticNarrowphase.cuh",
        "HydroelasticNarrowphaseFunc.cuh",
    ],
    copts = ["--std=c++17", "-O3", "--use_fast_math", "--extra-device-vectorization"],
    linkopts = ["-lcudart"],
    deps = [
        "//lib_utils:cuda_utils",
        "@eigen//:eigen",
    ],
)

cc_library(
    name = "collision_system_interface",
    hdrs = ["CollisionSystemBase.h"],
    copts = ["--std=c++17"],
)

cc_library(
    name = "hydroelastic_patch_collision_system",
    srcs = ["HydroelasticPatchCollisionSystem.cc"],
    hdrs = ["HydroelasticPatchCollisionSystem.h"],
    copts = ["--std=c++17"],
    deps = [
        ":collision_system_interface",
        ":hydroelastic_broadphase",
        ":hydroelastic_narrowphase",
        "//lib_utils:mesh_manager",
        "@eigen//:eigen",
    ],
)

cuda_library(
    name = "deme_mesh_collision_system",
    srcs = ["DemeMeshCollisionSystem.cu"],
    hdrs = ["DemeMeshCollisionSystem.h"],
    copts = ["--std=c++17", "-O3"],
    linkopts = ["-lcudart"],
    deps = [
        ":collision_system_interface",
        "//lib_utils:cuda_utils",
        "//lib_utils:surface_trimesh",
        "@dem_engine//:dem_engine_headers",
        "//third_party:dem_engine",
        "@eigen//:eigen",
    ],
)
