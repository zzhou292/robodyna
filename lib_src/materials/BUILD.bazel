package(default_visibility = ["//visibility:public"])

cc_library(
    name = "shell_elastic_law1",
    hdrs = ["ShellElasticLaw1.h"],
    deps = ["//lib_src/math:quaternion"],
)

cc_library(
    name = "shell_elastic_law1_point",
    hdrs = ["ShellElasticLaw1Point.h"],
    deps = [":shell_elastic_law1"],
)

cc_library(
    name = "tabulated_shell_plasticity",
    hdrs = [
        "TabulatedShellPlasticity.h",
        "detail/TabulatedShellPlasticityCurve.h",
        "detail/TabulatedShellPlasticityRate.h",
        "detail/TabulatedShellPlasticityUpdate.h",
        "detail/Law44ElasticParameters.h",
        "detail/Law44Hardening.h",
    ],
    deps = ["//lib_src/math:quaternion"],
)

cc_library(
    name = "materials",
    hdrs = [
        "MaterialModel.cuh",
        "MooneyRivlin.cuh",
        "SVK.cuh",
        "SolidMaterialProperties.h",
    ],
    copts = ["--std=c++17"],
)

cc_library(
    name = "law44_membrane",
    hdrs = ["Law44MembranePlasticity.h"],
    deps = [":law44_zero_shear"],
)

cc_library(
    name = "law44_zero_shear",
    hdrs = ["Law44ZeroShearPlasticity.h"],
    deps = [":tabulated_shell_plasticity"],
)

cc_library(
    name = "law44_scope",
    hdrs = ["Law44MaterialScope.h"],
    deps = [":tabulated_shell_plasticity"],
)
