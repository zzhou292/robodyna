load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs/examples:defs.bzl", "robodyna_cpp_demo")

package(default_visibility = ["//visibility:public"])

exports_files(["DemoCatalog.json", "sources.bzl", "BUILD.bazel"])

# One original Lander helper owner reused by both original mains.
cc_library(
    name = "lander_model",
    srcs = ["//src/compatibility/chrono:src/demos/robot/lander/model/Lander.cpp"],
    hdrs = ["//src/compatibility/chrono:src/demos/robot/lander/model/Lander.h"],
    strip_include_prefix = "/src/compatibility/chrono/src/demos/robot/lander",
    deps = ["//build_defs/chrono:native_core_fea"],
    tags = ["manual", "original-demo-model"],
)

robodyna_cpp_demo(
    name = "curiosity_rigid",
    srcs = ["//src/compatibility/chrono:src/demos/robot/curiosity/demo_ROBOT_Curiosity_Rigid.cpp"],
    deps = [
        "//src/robotics/models:models",
        "//src/vehicle/visualization:vsg",
        "//src/vehicle/visualization:irrlicht",
    ],
    features = ["vehicle", "vsg", "irrlicht"],
    tags = ["robotics-demo", "cpu-dynamics"],
)

