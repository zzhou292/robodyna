    srcs = ["//src/compatibility/chrono:src/demos/csharp/vehicle/demo_CS_VEH_CRGTerrain_IRR.cs"],
    deps = ["//build_defs/bindings/csharp/profiles:managed_opencrg"],
    tags = ["manual", "managed-demo", "retained-original-main"],
)

filegroup(name = "assemblies", srcs = [':road_course', ':road_course_alternate'], tags = ["manual"])
