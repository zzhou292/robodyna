    features = ["postprocess"],
    data = [
        "//src/compatibility/chrono:data/POVRay_chrono_template.pov",
        "//src/compatibility/chrono:data/models/forklift/body.obj",
        "//src/compatibility/chrono:data/textures/bluewhite.png",
    ],
)

robodyna_cpp_demo(
    name = "povray_particles",
    srcs = ["//src/compatibility/chrono:src/demos/postprocess/demo_POST_povray2.cpp"],
    features = ["postprocess"],
    data = [
        "//src/compatibility/chrono:data/POVRay_chrono_template.pov",
    ],
)

robodyna_cpp_demo(
    name = "blender_scene",
    srcs = ["//src/compatibility/chrono:src/demos/postprocess/demo_POST_blender.cpp"],
    features = ["postprocess"],
    data = [
        "//src/compatibility/chrono:data/models/forklift/body.obj",
        "//src/compatibility/chrono:data/textures/bluewhite.png",
    ],
)

robodyna_cpp_demo(
    name = "gnuplot",
    srcs = ["//src/compatibility/chrono:src/demos/postprocess/demo_POST_gnuplot.cpp"],
    features = ["postprocess"],
)

robodyna_cpp_demo(
    name = "timestepping",
    srcs = ["//src/compatibility/chrono:src/demos/postprocess/demo_POST_timestepping.cpp"],
    features = ["postprocess"],
)

robodyna_cpp_demo(
    name = "particle_creation",
    srcs = ["//src/compatibility/chrono:src/demos/postprocess/demo_POST_emit_creation.cpp"],
    features = ["postprocess", "irrlicht"],
    data = [
        "//src/compatibility/chrono:data/POVRay_chrono_template.pov",
    ],
)

robodyna_cpp_demo(
    name = "particle_assets",
    srcs = ["//src/compatibility/chrono:src/demos/postprocess/demo_POST_emitter_asset.cpp"],
    features = ["postprocess", "irrlicht"],
