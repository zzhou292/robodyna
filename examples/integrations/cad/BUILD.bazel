    deps = ["//src/integrations/cad:cad"],
    data = ["//src/integrations/cad:demo_assets", "@occt_sdk//:runtime"],
    features = ["vsg"],
    tags = ["cpu-dynamics", "native-cad"],
)

robodyna_cpp_demo(
    name = "profile_extrusion",
    srcs = ["//src/compatibility/chrono:src/demos/cascade/demo_CAS_profile.cpp"],
    deps = ["//src/integrations/cad:cad"],
    data = ["//src/integrations/cad:demo_assets", "@occt_sdk//:runtime"],
    features = ["vsg"],
    tags = ["cpu-dynamics", "native-cad"],
)

robodyna_cpp_demo(
    name = "mesh_converter",
    srcs = ["//src/compatibility/chrono:src/demos/cascade/demo_CAS_converter.cpp"],
    deps = ["//src/integrations/cad:irrlicht"],
    data = ["//src/integrations/cad:demo_assets", "@occt_sdk//:runtime"],
