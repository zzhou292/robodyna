load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build_defs/examples:defs.bzl", "robodyna_cpp_demo")
load(":sources.bzl", "ARTICULATED_HEADERS", "ARTICULATED_SOURCES")

package(default_visibility = ["//visibility:public"])

exports_files(["DemoCatalog.json", "sources.bzl", "BUILD.bazel"])

# Source-root demo helpers retain their original demos/... include spelling.
# They contain header definitions used by each main, never a second compiled TU.
cc_library(
    name = "solver_selection_headers",
    hdrs = ["//src/compatibility/chrono:src/demos/SetChronoSolver.h"],
    strip_include_prefix = "/src/compatibility/chrono/src",
    deps = ["//build_defs/chrono:native_core_fea"],
)

cc_library(
    name = "wheeled_models_headers",
    hdrs = ["//src/compatibility/chrono:src/demos/vehicle/WheeledVehicleModels.h"],
    strip_include_prefix = "/src/compatibility/chrono/src",
    deps = ["//src/vehicle/models:models"],
)

cc_library(
    name = "wheeled_json_headers",
    hdrs = ["//src/compatibility/chrono:src/demos/vehicle/WheeledVehicleJSON.h"],
    strip_include_prefix = "/src/compatibility/chrono/src",
    deps = ["//src/vehicle:vehicle"],
)

# Original eleven private model files used by the articulated-vehicle demo.
cc_library(
    name = "articulated_model",
    srcs = ["//src/compatibility/chrono:" + path for path in ARTICULATED_SOURCES],
    hdrs = ["//src/compatibility/chrono:" + path for path in ARTICULATED_HEADERS],
    strip_include_prefix = "/src/compatibility/chrono/src/demos/vehicle/articulated_vehicle",
    deps = ["//src/vehicle:vehicle"],
    tags = ["manual", "original-demo-model"],
)

