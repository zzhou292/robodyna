load("//build_defs/examples:defs.bzl", "robodyna_cpp_demo")

package(default_visibility = ["//visibility:public"])
exports_files(["DemoCatalog.json", "BUILD.bazel"])

# VSG is a build-wide capability here. Do not use the demo-only VSG or
# postprocess availability overlays: both affect inherited node object layouts.

robodyna_cpp_demo(
    name = 'wheel_rig',
    srcs = ['//src/compatibility/chrono:src/demos/vehicle/cosimulation/demo_VEH_Cosim_WheelRig.cpp'],
    deps = ['//src/vehicle/cosim:cosim', '//src/vehicle/models:models', '//examples/vehicle:solver_selection_headers'],
    data = ["@mpi_sdk//:runtime"],
    tags = ["mpi-program", "requires-explicit-runtime-assets"],
)

